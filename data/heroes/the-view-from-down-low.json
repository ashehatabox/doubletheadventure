      "life": [
        {
          "title": {
            "en": "A thorn-proof tongue"
          },
          "text": {
            "en": "A giraffe's tongue is 45–50 cm long and can grab. It's dark blue-black, which may protect it from sunburn, and thick spit guards against thorns."
          },
          "src": [
            "gcf-tongue",
            "pbs"
          ]
        },
        {
          "title": {
            "en": "The giraffe haircut"
          },
          "text": {
            "en": "Giraffes nibble trees so evenly that they leave a flat 'browse line' at about 4–5.5 m high. That's the highest they can reach!"
          },
          "src": [
            "sdz-giraffe-diet"
          ]
        },
        {
          "title": {
            "en": "Bending down is hard"
          },
          "text": {
            "en": "To drink, a giraffe has to splay its front legs wide or bend its knees. Special valves in its neck stop blood rushing to its head."
          },
          "src": [
            "bristol"
          ]
        },
        {
          "title": {
            "en": "Same neck bones as you"
          },
          "text": {
            "en": "A giraffe's neck has just seven bones, the same number as yours. Each one is just much, much longer."
          },
          "src": [
            "perth"
          ]
        }
      ],
      "facts": [
        {
          "kind": "wow",
          "title": {
            "en": "A two-metre welcome"
          },
          "text": {
            "en": "Giraffe moms give birth standing up, so the baby drops about 2 metres to the ground. Ouch! But within an hour it's standing."
          },
          "src": [
            "gcf-baby"
          ]
        },
        {
          "kind": "hidden",
          "title": {
            "en": "Spots like fingerprints"
          },
          "text": {
            "en": "No two giraffes have the same pattern. Each giraffe's patches are as unique as human fingerprints."
          },
          "src": [
            "pbs"
          ]
        },
        {
          "kind": "ha",
          "title": {
            "en": "Not silent after all"
          },
          "text": {
            "en": "People once thought giraffes were silent, but they make a soft mooing sound, especially with their calves."
          },
          "src": [
            "fresno-giraffe"
          ]
        },
        {
          "kind": "wow",
          "title": {
            "en": "Super pump"
          },
          "text": {
            "en": "Giraffes have the highest known blood pressure of any animal, to push blood all the way up that long neck."
          },
          "src": [
            "fresno-giraffe"
          ]
        },
        {
          "kind": "uhoh",
          "title": {
            "en": "Trees fight back"
          },
          "text": {
            "en": "When giraffes browse an acacia, the tree can grow longer thorns and make its leaves taste more bitter!"
          },
          "src": [
            "sdz-giraffe-diet"
          ]
        }
      ],
      "storyVsReal": {
        "en": "Real giraffes really do have trouble bending down: it's a wobbly, risky move. But a giraffe's horns, called ossicones, are real, and its heart-shaped neck patch is our artist's idea."
      },
      "storyVsRealSrc": [
        "bristol",
        "pbs"
      ]
    },
