      "life": [
        {
          "title": {
            "en": "The fourth biggest"
          },
          "text": {
            "en": "Leopard tortoises are the fourth largest tortoises in the world, named for the spots on their shell."
          },
          "src": [
            "southwicks"
          ]
        },
        {
          "title": {
            "en": "Borrowed homes"
          },
          "text": {
            "en": "They don't dig, except to lay eggs. To escape heat or cold they hide in burrows left by other animals."
          },
          "src": [
            "southwicks2"
          ]
        },
        {
          "title": {
            "en": "Tiny babies"
          },
          "text": {
            "en": "Hatchlings weigh just 23–50 g and are 4–5 cm long. Mom digs the nest, then stamps the soil down with her belly."
          },
          "src": [
            "sa-tortoise"
          ]
        }
      ],
      "facts": [
        {
          "kind": "wow",
          "title": {
            "en": "The world's longest wait"
          },
          "text": {
            "en": "Leopard tortoise eggs take 240 to 400 days to hatch. That's up to more than a year!"
          },
          "src": [
            "lvzoo"
          ]
        },
        {
          "kind": "ha",
          "title": {
            "en": "Bone snacks"
          },
          "text": {
            "en": "Leopard tortoises sometimes gnaw old bones and even hyena droppings, probably for the calcium their shells need."
          },
          "src": [
            "kruger-tortoise"
          ]
        },
        {
          "kind": "hidden",
          "title": {
            "en": "Armour for life"
          },
          "text": {
            "en": "Adults are so big that few predators can bite through the shell. Their eggs and babies are the ones in danger."
          },
          "src": [
            "lvzoo"
          ]
        }
      ],
      "storyVsReal": {
        "en": "Real leopard tortoises really are slow and steady. The acacia leaf stuck on Kulu's shell is our artist's idea, though one could easily get stuck there!"
      },
