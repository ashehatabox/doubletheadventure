<%- include('../partials/top') %>
<% const heads = lang === 'fr' ? ['Offre', 'Ce que c\'est', 'Comment'] : ['Offer', 'What it is', 'How']; %>
<section class="section tight">
  <div class="wrap stack" style="gap:28px">
    <p><a href="<%= url('/educators') %>" style="font-weight:800">← <%= t('educators.title') %></a></p>
    <div class="stack-sm" style="max-width:760px">
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= content.title %></h1>
      <p class="lead"><%= content.lead %></p>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="<%= content.title %>">
      <table>
        <thead><tr><% heads.forEach(function (h) { %><th scope="col"><%= h %></th><% }) %></tr></thead>
        <tbody><% content.offers.forEach(function (o) { %><tr><td style="font-weight:800" data-label="<%= heads[0] %>"><%= o[0] %></td><td data-label="<%= heads[1] %>"><%= o[1] %></td><td data-label="<%= heads[2] %>"><% if (o[3]) { %><a href="<%= url(o[3]) %>" style="font-weight:800"><%= o[2] %></a><% } else { %><%= o[2] %><% } %></td></tr><% }) %></tbody>
      </table>
    </div>
    <% if (content.note) { %><p class="muted" style="margin:0;max-width:760px"><%= content.note %></p><% } %>
  </div>
</section>
<% if (key === 'teachers' || key === 'early-years') { %>
<section class="section tight" style="padding-top:0" aria-labelledby="lic-title">
  <div class="wrap stack" style="gap:16px">
    <div class="stack-sm" style="max-width:760px"><h2 id="lic-title" class="h2" style="font-size:32px"><%= t('licences.title') %></h2><p class="lead"><%= t('licences.lead') %></p></div>
    <table class="dtable" style="max-width:760px"><tbody><% t('licences.items').forEach(function (x) { %><tr><th scope="row"><%= x %></th><td><%- include('../partials/pending', { k: 'price' }) %></td></tr><% }) %></tbody></table>
    <p class="muted" style="margin:0;max-width:760px"><%= t('invoice.note') %> <%= t('libs.poText').replace(/[^.]*\.\s*/, '') %> <%- include('../partials/pending', { k: 'terms' }) %></p>
  </div>
</section>
<% } %>
<% if (content.showBooks && guideCovers.length) { %><%- include('../partials/educator-books') %><% } %>
<section class="section tight" style="padding-top:0">
  <div class="wrap" style="max-width:760px">
    <% if (invoiceFor) { %>
    <%- include('../partials/enquiry', { kind: 'quote', topic: 'invoice', formTitle: t('invoice.formTitle') + (invoiceFor.trim() ? ': ' + invoiceFor : ''), messageLabel: t('invoice.messageLabel') }) %>
    <% } else { %>
    <%- include('../partials/enquiry', { kind: content.formKind, formTitle: content.formTitle }) %>
    <% } %>
  </div>
</section>
<%- include('../partials/bottom') %>
