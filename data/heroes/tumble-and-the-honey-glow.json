      "life": [
        {
          "title": {
            "en": "The great autumn feast"
          },
          "text": {
            "en": "In autumn, bears enter hyperphagia: their body switches off the feeling of being full, so they eat non-stop. Some gain up to 4 pounds (almost 2 kg) in a single day!"
          },
          "src": [
            "doi-katmai"
          ]
        },
        {
          "title": {
            "en": "The longest nap"
          },
          "text": {
            "en": "All winter, a bear lives on the fat she stored. She doesn't eat, drink, pee or poop, sometimes for months, and wakes up in spring thin and hungry."
          },
          "src": [
            "nps-katm-hib",
            "doi-katmai"
          ]
        },
        {
          "title": {
            "en": "A light sleeper"
          },
          "text": {
            "en": "It isn't a deep, cold hibernation: a bear's body cools only a few degrees, so she can wake up quickly if something disturbs her den."
          },
          "src": [
            "adw-bear"
          ]
        }
      ],
      "facts": [
        {
          "kind": "wow",
          "title": {
            "en": "Muscles that grow in bed"
          },
          "text": {
            "en": "Hibernating bears recycle the waste from their bodies back into protein, so they can even gain muscle over the winter."
          },
          "src": [
            "nps-glac"
          ]
        },
        {
          "kind": "ha",
          "title": {
            "en": "A fat bear is a happy bear"
          },
          "text": {
            "en": "In Alaska's Katmai National Park, people vote every autumn for the fattest bear in Fat Bear Week. For a bear, fat means a safe winter."
          },
          "src": [
            "doi-katmai"
          ]
        },
        {
          "kind": "uhoh",
          "title": {
            "en": "Waking up hungry"
          },
          "text": {
            "en": "After months without food, a bear leaves the den in spring skinny and hungry, and takes a few weeks to get her body working normally again."
          },
          "src": [
            "nps-glac",
            "doi-katmai"
          ]
        }
      ],
      "storyVsReal": {
        "en": "Real mother bears don't stir honey into warm milk, but they really do raise their cubs alone and care for them for years."
