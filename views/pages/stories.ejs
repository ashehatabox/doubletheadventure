<%- include('../partials/top') %>
<section class="section tight band-sky">
  <div class="wrap stack-sm" style="max-width:820px;margin-left:auto;margin-right:auto">
    <p class="eyebrow"><a href="<%= url('/play') %>"><%= t('nav.play') %></a></p>
    <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('readaloud.title') %></h1>
    <p class="lead"><%= t('readaloud.lead') %></p>
  </div>
</section>
<section class="section tight">
  <div class="wrap">
    <% if (!list.length) { %>
      <p class="lead"><%= t('readaloud.none') %></p>
      <a class="btn btn-primary" href="<%= url('/play') %>"><%= t('nav.play') %></a>
    <% } else { %>
    <div class="ra-grid">
      <% list.forEach(function (b) { %>
      <a class="card ra-card" href="<%= b.href %>#read-aloud">
        <span class="ra-thumb"><% if (b.coverSmall || b.cover) { %><img src="<%= b.coverSmall || b.cover %>" alt="" loading="lazy" width="360" height="576"><% } %><span class="ra-btn" aria-hidden="true">▶</span></span>
        <span class="ra-card-title"><%= b.displayTitle %></span>
        <span class="muted"><%= b.valueText %> · <%= b.langs.join(' · ') %></span>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/bottom') %>
