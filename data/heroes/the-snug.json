        ]
      },
      {
        "kind": "hidden",
        "title": {
          "en": "Keep out, forest only"
        },
        "text": {
          "en": "Sasso Fratino became Italy's first strict nature reserve in 1959. Visitors can't go in, so the forest grows wild."
        },
        "src": [
          "wiki-park2"
        ]
      },
      {
        "kind": "ha",
        "title": {
          "en": "Monks in the woods"
