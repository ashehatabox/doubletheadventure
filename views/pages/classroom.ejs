<%- include('../partials/top') %>
<section class="section tight band-sky">
  <div class="wrap stack-sm" style="max-width:820px">
    <p class="muted"><a href="<%= url('/educators') %>"><%= t('nav.educators') %></a></p>
    <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('classroom.title') %></h1>
    <p class="lead"><%= t('classroom.lead') %></p>
    <div class="row" style="gap:12px;flex-wrap:wrap">
      <a class="btn btn-primary" href="#finder"><%= t('classroom.ctaFinder') %></a>
      <a class="btn" href="#printables"><%= t('classroom.ctaPrint') %></a>
    </div>
  </div>
</section>

<section class="section tight" id="finder">
  <div class="wrap stack" style="gap:20px">
    <div class="stack-sm" style="max-width:720px">
      <h2 class="h2" style="font-size:32px"><%= t('classroom.finderTitle') %></h2>
      <p class="lead"><%= t('classroom.finderLead') %></p>
    </div>
    <div class="chips" style="gap:10px" data-filter>
      <a class="pill" href="<%= url('/educators/classroom') %>#finder" data-moment="" <%- moment ? '' : 'aria-current="true"' %>><%= t('classroom.all') %></a>
      <% moments.forEach(function (m) { %><a class="pill" href="<%= url('/educators/classroom') %>?moment=<%= m %>#finder" data-moment="<%= m %>" <%- moment === m ? 'aria-current="true"' : '' %>><%= momentLabel(m) %></a><% }) %>
    </div>
    <ul class="edu-books cls-books" data-books>
      <% list.forEach(function (b) { const hide = moment && !(b.moments || []).includes(moment); %>
      <li class="edu-book" data-moments="<%= (b.moments || []).join(' ') %>" <%- hide ? 'hidden' : '' %>>
        <a class="edu-cover" href="<%= url('/educators/guides/' + b.slug) %>"><img src="<%= b.coverSmall || b.cover %>" alt="<%= t('classroom.guide') %>: <%= b.displayTitle %>" loading="lazy" width="360" height="576"></a>
        <h3 class="edu-title"><%= b.displayTitle %></h3>
        <% if (b.valueText) { %><p class="edu-value"><%= b.valueText %></p><% } %>
        <% if (b.refrain) { %><p class="cls-refrain">“<%= b.refrain %>”</p><% } %>
        <p class="edu-links">
          <a href="<%= url('/educators/guides/' + b.slug) %>"><%= t('classroom.guide') %></a>
          <% if (b.hasReader) { %><a href="<%= b.readHref %>"><%= t('classroom.bigScreen') %></a><% } %>
          <% if (b.hasVideo) { %><a href="<%= url('/books/' + b.slug) %>#read-aloud"><%= t('classroom.watch') %></a><% } %>
          <a href="<%= url('/educators/classroom/cards') %>?book=<%= b.slug %>"><%= t('classroom.card') %></a>
          <a href="<%= url('/educators/classroom/posters') %>?book=<%= b.slug %>"><%= t('classroom.poster') %></a>
        </p>
      </li>
      <% }) %>
    </ul>
    <p class="muted" data-none <%- list.some(function (b) { return !moment || (b.moments || []).includes(moment); }) ? 'hidden' : '' %>><%= t('classroom.none') %></p>
  </div>
</section>

<section class="section band-sunpale" id="big-screen">
  <div class="wrap stack" style="gap:24px">
    <div class="stack-sm" style="max-width:720px">
      <h2 class="h2"><%= t('classroom.screenTitle') %></h2>
      <p class="lead"><%= t('classroom.screenLead') %></p>
    </div>
    <ol class="cls-steps">
      <% t('classroom.screenSteps').forEach(function (s, i) { %>
      <li><span class="cls-num"><%= i + 1 %></span><h3 class="cls-step-title"><%= s.title %></h3><p><%= s.text %></p></li>
      <% }) %>
    </ol>
    <p class="muted" style="max-width:720px"><%= t('classroom.screenNote') %></p>
  </div>
</section>

<section class="section" id="printables">
  <div class="wrap stack" style="gap:24px">
    <div class="stack-sm" style="max-width:720px">
      <h2 class="h2"><%= t('classroom.printTitle') %></h2>
      <p class="lead"><%= t('classroom.printLead') %></p>
    </div>
    <div class="grid-cards">
      <% t('classroom.prints').forEach(function (p) { %>
      <a class="card cls-print" href="<%= url(p.href) %>"><span class="cls-print-title"><%= p.title %></span><span class="muted"><%= p.text %></span></a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section band-mint" id="year">
  <div class="wrap stack" style="gap:24px">
    <div class="stack-sm" style="max-width:720px">
      <h2 class="h2"><%= t('classroom.yearTitle') %></h2>
      <p class="lead"><%= t('classroom.yearLead') %></p>
    </div>
    <ol class="cls-year">
      <% year.forEach(function (m, i) { %>
      <li class="cls-month">
        <h3 class="cls-month-name"><%= m.month %></h3>
        <p class="cls-month-idea"><%= t('classroom.monthIdeas')[i] %></p>
        <ul class="cls-month-books">
          <% m.books.forEach(function (b) { %><li><a href="<%= url('/educators/guides/' + b.slug) %>"><img src="<%= b.coverSmall || b.cover %>" alt="<%= t('common.coverOf') %> <%= b.displayTitle || bookTitle(b) %>" loading="lazy" width="60" height="96"><span><%= b.displayTitle %><% if (b.valueText) { %><small><%= b.valueText %></small><% } %></span></a></li><% }) %>
        </ul>
      </li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section" id="cultural-review">
  <div class="wrap stack" style="gap:24px">
    <div class="stack-sm" style="max-width:720px">
      <h2 class="h2"><%= t('classroom.reviewTitle') %></h2>
      <p class="lead"><%= t('classroom.reviewLead') %></p>
    </div>
    <ol class="cls-steps">
      <% t('classroom.reviewSteps').forEach(function (s, i) { %>
      <li><span class="cls-num"><%= i + 1 %></span><h3 class="cls-step-title"><%= s.title %></h3><p><%= s.text %></p></li>
      <% }) %>
    </ol>
    <div class="stack-sm" style="max-width:720px">
      <p><%= t('classroom.reviewNote') %></p>
      <a class="btn btn-primary" style="align-self:flex-start" href="<%= url('/books/review-team') %>"><%= t('classroom.reviewCta') %></a>
    </div>
  </div>
</section>
<%- include('../partials/bottom') %>
