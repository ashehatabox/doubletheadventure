<%- include('../partials/top') %>
<section class="section tight">
  <div class="wrap grid-2" style="align-items:start">
    <div class="stack">
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('about.title') %></h1>
      <p class="lead"><%= t('about.lead') %></p>
      <% t('about.paragraphs').forEach(function (p) { %><p style="margin:0"><%= p %></p><% }) %>
      <h2 class="h3"><%= t('about.authorsTitle') %></h2>
      <p style="margin:0;font-weight:700"><%= t('about.authors') %></p>
      <div class="row"><a class="btn btn-primary" href="<%= url('/books') %>"><%= t('common.exploreBooks') %></a></div>
    </div>
    <div class="hero-art">
      <% ['the-snug', 'eight-times-up', 'the-old-path-song'].forEach(function (s) { %><%- include('../partials/cover', { b: allBooks.find(function (b) { return b.slug === s; }) }) %><% }) %>
    </div>
  </div>
</section>
<%- include('../partials/bottom') %>
