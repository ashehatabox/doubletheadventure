<%- include('../partials/top') %>
<section class="section tight band-sun">
  <div class="wrap stack-sm" style="max-width:820px;margin-left:auto;margin-right:auto">
    <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('start.title') %></h1>
    <p class="lead"><%= t('start.lead') %></p>
  </div>
</section>
<section class="section tight">
  <div class="wrap stack" style="gap:24px">
    <h2 class="h2" style="font-size:30px"><%= t('start.question') %></h2>
    <div class="start-grid">
      <% items.forEach(function (it) { %>
      <a class="card start-card" href="<%= it.href %>"><span class="start-label"><%= it.label %></span><span class="muted"><%= it.count %> <%= it.count === 1 ? t('start.book') : t('start.books') %></span></a>
      <% }) %>
    </div>
    <p class="muted"><a href="<%= url('/books') %>"><%= t('common.exploreBooks') %></a> · <a href="<%= url('/values') %>"><%= t('footer.values') %></a></p>
  </div>
</section>
<%- include('../partials/bottom') %>
