  "activities": [
    {
      "title": {
        "en": "Build a bridge together"
      },
      "text": {
        "en": "Use blocks, sticks or paper to build a bridge with a friend. Who did which job?"
      }
    },
    {
      "title": {
        "en": "Beaver chew"
      },
      "text": {
        "en": "Crunch a carrot and think about a beaver's strong teeth. Theirs never stop growing!"
      }
    },
    {
      "title": {
        "en": "Cone count"
      },
      "text": {
        "en": "Collect pine cones on a walk. How many could you store, like a red squirrel?"
      }
    },
    {
      "title": {
        "en": "Chatter call"
      },
      "text": {
        "en": "Make up a squirrel chatter. Use it to say 'hello' instead of 'go away'!"
      }
    },
    {
      "title": {
        "en": "Find Algonquin"
      },
      "text": {
        "en": "Find Toronto on a map of Ontario, then look north for Algonquin Park."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Why are beaver teeth orange?"
      },
      "a": {
        "en": "Their enamel has iron in it, which makes the teeth extra strong for chewing wood."
      },
      "src": [
        "nz-bv"
      ]
    },
    {
      "q": {
        "en": "Do beavers build bridges?"
      },
      "a": {
        "en": "Not really. They build dams across water and lodges to live in."
      },
      "src": [
        "aff-bv"
      ]
    },
    {
      "q": {
        "en": "Where do red squirrels keep their food?"
      },
      "a": {
        "en": "In a big pile of cones called a midden, which they guard all winter."
      },
      "src": [
        "yk-rs"
      ]
    },
    {
      "q": {
        "en": "Is the beaver Canada's animal?"
      },
      "a": {
        "en": "Yes. It became an official symbol of Canada in 1975."
      },
      "src": [
        "fa-bv"
      ]
    }
  ],
