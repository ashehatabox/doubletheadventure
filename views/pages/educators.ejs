<%- include('../partials/top') %>
<section class="section tight">
  <div class="wrap stack" style="gap:32px">
    <div class="stack-sm" style="max-width:760px">
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('educators.title') %></h1>
      <p class="lead"><%= t('educators.lead') %></p>
      <div class="row" style="gap:12px;flex-wrap:wrap">
        <a class="btn btn-primary" href="<%= url('/educators/guides') %>"><%= t('educators.ctaGuides') %></a>
        <a class="btn" href="#class-sets"><%= t('educators.ctaSets') %></a>
        <a class="btn" href="<%= url('/educators/classroom') %>"><%= t('classroom.title') %></a>
      </div>
    </div>
    <div class="grid-cards">
      <% t('educators.doors').forEach(function (d, i) { const cls = ['educators', 'play', 'parents'][i]; %>
      <a class="door <%= cls %>" href="<%= d.href.charAt(0) === '#' ? d.href : url(d.href) %>"><span class="door-title"><%= d.title %></span><span class="door-text"><%= d.text %></span></a>
      <% }) %>
    </div>
  </div>
</section>
<section class="section feature-band band-sunpale">
  <div class="wrap feature">
    <div class="guide-stack" aria-hidden="true">
      <% guideCovers.slice(0, 5).forEach(function (b, i) { %><img src="<%= b.coverSmall || b.cover %>" alt="" loading="lazy" width="360" height="576" style="--i:<%= i %>"><% }) %>
    </div>
    <div class="feature-text stack">
      <h2 class="h2 feature-h"><%= t('guides.title') %></h2>
      <p class="lead"><%= t('guides.lead') %></p>
      <ul class="glance"><li><%= t('educators.guideCount').replace('{n}', guideCovers.length) %></li><li><%= t('educators.guideFree') %></li></ul>
      <a class="btn btn-primary" style="align-self:flex-start" href="<%= url('/educators/guides') %>"><%= t('guides.title') %></a>
    </div>
  </div>
</section>
<div id="find-a-book"></div>
<%- include('../partials/educator-books') %>
<section class="section band-mint" id="class-sets">
  <div class="wrap stack" style="gap:24px">
    <div class="stack-sm" style="max-width:720px">
      <h2 class="h2"><%= t('educators.setsTitle') %></h2>
      <p class="lead"><%= t('educators.setsLead') %></p>
    </div>
    <div class="grid-cards">
      <% classSets.forEach(function (p) { %>
      <div class="card card-pad stack-sm">
        <h3 class="h3" style="margin:0"><%= p.title %></h3>
        <p style="margin:0;font-weight:800;font-size:30px">$<%= p.price %> <span class="muted" style="font-size:15px;font-weight:600">CAD</span></p>
        <p class="muted" style="margin:0"><%= t('educators.setsAmazon').replace('{price}', p.amazon) %></p>
        <a class="btn btn-primary" style="align-self:flex-start" href="<%= url('/shop') %>#<%= p.id %>"><%= t('educators.setsOrder') %></a>
      </div>
      <% }) %>
    </div>
    <p class="muted" style="margin:0;max-width:760px"><%= t('educators.setsNote') %></p>
  </div>
</section>
<section class="section">
  <div class="wrap stack" style="gap:28px">
    <div class="stack-sm" style="max-width:720px">
      <h2 class="h2"><%= t('educators.insideTitle') %></h2>
      <p class="lead"><%= t('educators.insideLead') %></p>
    </div>
    <%- include('../partials/inside', { sc: showcase, k: 'educators' }) %>
  </div>
</section>
<section class="section band-sky">
  <div class="wrap stack-sm" style="max-width:860px">
    <h2 class="h2" style="font-size:32px"><%= t('educators.curriculumTitle') %></h2>
    <ul class="clean"><% t('educators.curriculum').forEach(function (c) { %><li><% if (c.href) { %><a href="<%= c.href %>" style="font-weight:800" rel="noopener"><%= c.name %></a>: <% } %><%= c.text || c %></li><% }) %></ul>
  </div>
</section>
<section class="section">
  <div class="wrap stack" style="gap:24px">
    <h2 class="h2" style="font-size:32px"><%= t('educators.settingTitle') %></h2>
    <div class="grid-cards">
      <% t('educators.cards').forEach(function (c, i) { const cls = ['educators', 'play', 'parents', 'partners'][i]; %>
      <a class="door <%= cls %>" href="<%= url('/educators/' + c.key) %>"><span class="door-title"><%= c.title %></span><span class="door-text"><%= c.text %></span></a>
      <% }) %>
    </div>
  </div>
</section>
<%- include('../partials/bottom') %>
