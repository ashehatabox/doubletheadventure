      "life": [
        {
          "title": {
            "en": "Born tiny, in the dark"
          },
          "text": {
            "en": "Tumble started life in the middle of winter, inside Mom's den: blind, without fur, and smaller than a block of butter. While Mom slept, he snuggled in and drank her milk."
          },
          "src": [
            "adw-bear",
            "nps-yose"
          ]
        },
        {
          "title": {
            "en": "A long time with Mom"
          },
          "text": {
            "en": "Bear cubs stay with their mothers for two to three years, and drink milk for up to two and a half. That's a lot of bedtime stories."
          },
          "src": [
            "adw-bear",
            "doi-katmai"
          ]
        },
        {
          "title": {
            "en": "No dad around"
          },
          "text": {
            "en": "Brown bears mostly live alone. The only lasting family bond is between a mother and her cubs, so Mama Bear raises Tumble by herself."
          },
          "src": [
            "adw-bear"
          ]
        }
      ],
      "facts": [
        {
          "kind": "wow",
          "title": {
            "en": "Born while Mom is asleep"
          },
          "text": {
            "en": "A mother bear gives birth during her winter sleep and nurses her cubs without leaving the den, eating or drinking."
          },
          "src": [
            "nps-glac",
            "nps-yose"
          ]
        },
        {
          "kind": "ha",
          "title": {
            "en": "Pooh was half right"
          },
          "text": {
            "en": "Wild bears do raid beehives and love honey. But what they really want is the baby bees inside, which are full of protein. Bad news for Zuzu's family!"
          },
          "src": [
            "mentalfloss"
          ]
        },
        {
          "kind": "hidden",
          "title": {
            "en": "A big nose for a small bear"
          },
          "text": {
            "en": "Bears have human-like hearing and poor eyesight, but a super nose: they can follow a smell for more than three kilometres."
          },
          "src": [
            "adw-bear"
          ]
        }
      ],
      "storyVsReal": {
        "en": "In autumn a real cub Tumble's age would be eating everything in sight to get ready for his winter sleep, and by first snow he'd be heading into the den with Mom, not off to the games."
