<%- include('../partials/top') %>
<section class="section tight band-sky">
  <div class="wrap stack-sm">
    <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('readwatch.title') %></h1>
    <p class="lead"><%= t('readwatch.lead') %></p>
    <% if (readList.length && list.length) { %>
    <nav class="jump" style="padding:8px 0 0" aria-label="<%= t('readwatch.title') %>">
      <a class="pill" href="#read"><%= t('readwatch.readTitle') %> (<%= readList.length %>)</a>
      <a class="pill" href="#watch"><%= t('readwatch.watchTitle') %> (<%= list.length %>)</a>
    </nav>
    <% } %>
  </div>
</section>

<% if (readList.length) { %>
<section class="section" id="read">
  <div class="wrap stack" style="gap:28px">
    <div class="feature-head stack-sm">
      <h2 class="h2 feature-h"><%= t('readwatch.readTitle') %></h2>
      <p class="lead"><%= t('readwatch.readLead') %></p>
    </div>
    <div class="rw-grid">
      <% readList.forEach(function (r) { %>
      <a class="rw-card" href="<%= r.href %>">
        <span class="rw-spread"><% r.preview.pages.forEach(function (p) { %><img src="<%= p %>" alt="<%= t('common.altSpread') %>" loading="lazy" width="1000" height="1000"><% }) %></span>
        <span class="rw-title" <%- r.book.titleIsFallback ? 'lang="en"' : '' %>><%= r.book.displayTitle %></span>
        <span class="rw-meta"><%= r.book.valueText %> · <%= t('book.readPages').replace('{n}', r.preview.totalPages) %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section band-rose" id="watch">
  <div class="wrap stack" style="gap:28px">
    <div class="feature-head stack-sm">
      <h2 class="h2 feature-h"><%= t('readwatch.watchTitle') %></h2>
      <p class="lead"><%= t('readaloud.lead') %></p>
    </div>
    <% if (!list.length) { %>
      <p class="lead"><%= t('readaloud.none') %></p>
    <% } else { %>
    <div class="ra-grid">
      <% list.forEach(function (b) { %>
      <a class="card ra-card" href="<%= b.href %>#read-aloud">
        <span class="ra-thumb"><% if (b.coverSmall || b.cover) { %><img src="<%= b.coverSmall || b.cover %>" alt="<%= t('common.coverOf') %> <%= b.displayTitle || bookTitle(b) %>" loading="lazy" width="360" height="576"><% } %><span class="ra-btn" aria-hidden="true">▶</span></span>
        <span class="ra-card-title"><%= b.displayTitle %></span>
        <span class="muted"><%= b.valueText %> · <%= b.langs.join(' · ') %></span>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/bottom') %>
