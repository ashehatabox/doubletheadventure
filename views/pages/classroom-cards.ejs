<%- include('../partials/top') %>
<section class="section tight no-print">
  <div class="wrap stack-sm" style="max-width:820px">
    <p class="muted"><a href="<%= url('/educators/classroom') %>"><%= t('classroom.cardsBack') %></a></p>
    <h1 class="h1" style="font-size:clamp(32px,4.2vw,48px)"><%= t('classroom.cardsTitle') %></h1>
    <p class="lead"><%= t('classroom.cardsLead') %></p>
    <div class="row" style="gap:12px;flex-wrap:wrap;align-items:center">
      <button class="btn btn-primary" type="button" data-print><%= t('classroom.cardsPrint') %></button>
      <% if (cards.length === 1) { %><a class="btn" href="<%= url('/educators/classroom/cards') %>"><%= t('classroom.all') %></a><% } %>
    </div>
    <p class="muted"><%= t('classroom.cardsTip') %></p>
  </div>
</section>
<section class="section tight qr-page">
  <div class="wrap">
    <ul class="qr-sheet">
      <% cards.forEach(function (b) { %>
      <li class="qr-card">
        <img class="qr-cover" src="<%= b.coverSmall || b.cover %>" alt="" width="360" height="576">
        <div class="qr-body">
          <h2 class="qr-title"><%= b.displayTitle %></h2>
          <% if (b.valueText) { %><p class="qr-value"><%= b.valueText %></p><% } %>
          <div class="qr-code" role="img" aria-label="<%= t('classroom.cardsScan') %>: <%= b.displayTitle %>"><%- b.qr %></div>
          <p class="qr-scan"><%= t('classroom.cardsScan') %></p>
        </div>
      </li>
      <% }) %>
    </ul>
  </div>
</section>
<%- include('../partials/bottom') %>
