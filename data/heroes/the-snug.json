  "faq": [
    {
      "q": {
        "en": "Are the animals in The Snug real?"
      },
      "a": {
        "en": "Yes. Crested porcupines, European badgers, red squirrels, wood mice, moles and rabbits are all real. Each hero file tells you what we changed for the story."
      }
    },
    {
      "q": {
        "en": "Do badgers and porcupines really share homes?"
      },
      "a": {
        "en": "Yes. In Italy, cameras have filmed porcupines and badgers using the same burrows."
      },
      "src": [
        "coppola"
      ]
    },
    {
      "q": {
        "en": "Can porcupines throw their quills?"
      },
      "a": {
        "en": "No. The quills only come out when something touches them."
      },
      "src": [
        "southwicks"
      ]
    },
    {
      "q": {
        "en": "Where do porcupines live in Europe?"
      },
      "a": {
        "en": "Only in Italy. The crested porcupine is the only porcupine in Europe."
      },
      "src": [
