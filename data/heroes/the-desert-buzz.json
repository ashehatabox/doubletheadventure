 "activities": [
  {
   "title": {
    "en": "Desert breeze breath"
   },
   "text": {
    "en": "When you feel angry, breathe in slowly, then blow out like a soft desert breeze. Try it three times."
   }
  },
  {
   "title": {
    "en": "Waggle dance"
   },
   "text": {
    "en": "Hide a toy, then do a dance to show where it is. Can your family find it?"
   }
  },
  {
   "title": {
    "en": "Sand tower"
   },
   "text": {
    "en": "Build a tower with blocks or sand. If it falls, what can you say or do?"
   }
  },
  {
   "title": {
    "en": "Night glow"
   },
   "text": {
    "en": "Draw a scorpion with a glow-in-the-dark or bright green crayon, like it looks under UV light."
   }
  },
