      "life": [
        {
          "title": {
            "en": "Eating on their knees"
          },
          "text": {
            "en": "Warthogs kneel on their front legs to graze. The knee pads they use are already there before they're born!"
          },
          "src": [
            "fresno-warthog"
          ]
        },
        {
          "title": {
            "en": "Backing in"
          },
          "text": {
            "en": "Piglets run into the burrow head first, but adults spin around and back in, so their tusks face the door."
          },
          "src": [
            "wildlifesafari-wh"
          ]
        },
        {
          "title": {
            "en": "Tails up, follow me!"
          },
          "text": {
            "en": "When a family runs, their tails stand straight up like flags, so they can keep together in long grass."
          },
          "src": [
            "hluhluwe"
          ]
        }
      ],
      "facts": [
        {
          "kind": "wow",
          "title": {
            "en": "Fast pigs"
          },
          "text": {
            "en": "A startled warthog can run up to 50 km/h."
          },
          "src": [
            "africageo-wh"
          ]
        },
        {
          "kind": "ha",
          "title": {
            "en": "Mud spa"
          },
          "text": {
            "en": "Warthogs roll in mud to cool off and keep biting insects away."
          },
          "src": [
            "safariwest-wh",
            "fresno-warthog"
          ]
        },
        {
          "kind": "hidden",
          "title": {
            "en": "Water optional"
          },
          "text": {
            "en": "Warthogs don't need to drink often, but they will if water is around."
          },
          "src": [
            "wildlifesafari-wh"
          ]
        }
      ],
      "storyVsReal": {
        "en": "Real warthog piglets often have siblings born at the same time, so twins are very believable. One muddy nose? Also very believable!"
      },
      "storyVsRealSrc": [
        "sdz-warthog",
        "safariwest-wh"
      ]
    }
  ],
  "activities": [
    {
      "title": {
        "en": "Down low walk"
      },
      "text": {
        "en": "Crouch down to a toddler's height and walk around your home. What can't you see from down there?"
      }
    },
    {
      "title": {
        "en": "Up high look"
      },
      "text": {
        "en": "Stand on a safe step with a grown-up. What new things can you see from up high?"
      }
    },
    {
      "title": {
        "en": "Meerkat lookout"
      },
      "text": {
        "en": "Take turns being the lookout while others play. Call out \"kek-kek!\" if you spot the 'eagle' (a grown-up)."
      }
    },
    {
      "title": {
        "en": "Giraffe tongue"
      },
      "text": {
        "en": "Measure 45 cm on a string. That's how long a giraffe's tongue is! Is it longer than your arm?"
      }
    },
    {
      "title": {
        "en": "Find the Kalahari"
      },
      "text": {
        "en": "Find South Africa on a map, then the Kalahari in the north-west of the country."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Are the animals in The View From Down Low real?"
      },
      "a": {
        "en": "Yes. Giraffes, meerkats, leopard tortoises, helmeted guineafowl and warthogs all live in Southern Africa. Each hero file tells you what we changed for the story."
      }
    },
    {
      "q": {
        "en": "Why can't giraffes bend down easily?"
      },
      "a": {
        "en": "Their necks are too short to reach the ground, so they must splay their front legs or bend their knees. Special valves protect their brain from a rush of blood."
      },
      "src": [
        "bristol"
      ]
    },
    {
      "q": {
        "en": "Do meerkats really take turns keeping watch?"
      },
      "a": {
        "en": "Yes. One meerkat usually stands guard on a high spot while the others feed."
      },
      "src": [
        "adw-meerkat"
      ]
    },
    {
      "q": {
        "en": "Can I see meerkats in the wild?"
      },
      "a": {
        "en": "Yes. At Tswalu, two meerkat families are used to people, so visitors can watch them quietly up close."
      },
      "src": [
        "aws-tswalu"
      ]
    }
  ],
