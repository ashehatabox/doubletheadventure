        {
          "title": {
            "en": "Keets on the go"
          },
          "text": {
            "en": "Baby guineafowl are called keets. They start feeding with the flock just a few hours after hatching."
          },
          "src": [
            "safariwest-gf",
            "sydneyzoo"
          ]
        },
        {
          "title": {
            "en": "Day shift, night shift"
          },
          "text": {
            "en": "For the first two weeks, mom keeps the keets warm at night and dad takes the day shift."
          },
          "src": [
            "adw-gf"
          ]
        },
        {
          "title": {
            "en": "Flying in four weeks"
          },
          "text": {
            "en": "Keets can fly at about four weeks old and stay with their parents for a while after."
          },
          "src": [
