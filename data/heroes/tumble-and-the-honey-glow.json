    "facts": [
      {
        "kind": "wow",
        "title": {
          "en": "Bear country"
        },
        "text": {
          "en": "Romania's Carpathian Mountains have more wild brown bears than anywhere else in Europe outside Russia, and some of Europe's biggest old-growth forests."
        },
        "src": [
          "popescu"
        ]
      },
      {
        "kind": "wow",
        "title": {
          "en": "The tree that feeds a city"
        },
        "text": {
          "en": "In Britain, scientists counted 2,300 kinds of living things that use oak trees, and 326 that can't live without them. Some oaks live more than 1,000 years."
        },
        "src": [
          "woodland-oak"
        ]
      },
      {
        "kind": "hidden",
        "title": {
          "en": "Bears really do sleep in trees"
        },
        "text": {
          "en": "Tumble's den is inside a giant oak. That's real bear behaviour: in the Great Smoky Mountains, many bears den high up inside standing hollow trees."
        },
        "src": [
          "nps-smokies"
        ]
      },
      {
        "kind": "ha",
        "title": {
          "en": "Squirrels plant forests by accident"
        },
        "text": {
          "en": "Red squirrels bury seeds for winter, then forget some of them. The forgotten ones can grow into new trees."
        },
        "src": [
          "mammal-squirrel"
        ]
      }
