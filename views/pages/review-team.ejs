<%- include('../partials/top') %>
<section class="section tight">
  <div class="wrap grid-2" style="align-items:start">
    <div class="stack">
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('reviewTeam.title') %></h1>
      <p class="lead"><%= t('reviewTeam.lead') %></p>
      <ul class="clean"><% t('reviewTeam.points').forEach(function (p) { %><li><%= p %></li><% }) %></ul>
    </div>
    <%- include('../partials/enquiry', { kind: 'review-team', showOrg: false, messageLabel: t('reviewTeam.messageLabel'), button: t('reviewTeam.button') }) %>
  </div>
</section>
<%- include('../partials/bottom') %>
