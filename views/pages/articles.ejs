<%- include('../partials/top') %>
<section class="section tight band-sun">
  <div class="wrap stack-sm" style="max-width:820px;margin-left:auto;margin-right:auto">
    <p class="eyebrow"><a href="<%= url('/parents') %>"><%= t('nav.parents') %></a></p>
    <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('articles.title') %></h1>
    <p class="lead"><%= t('articles.lead') %></p>
  </div>
</section>
<section class="section tight">
  <div class="wrap stack" style="gap:28px">
    <% if (topics.length > 1) { %>
    <nav class="chips" style="gap:10px" aria-label="<%= t('articles.title') %>">
      <a class="pill" href="<%= url('/parents/articles') %>" aria-current="<%= topic ? 'false' : 'true' %>"><%= t('articles.all') %></a>
      <% topics.forEach(function (tp) { %><a class="pill" href="<%= url('/parents/articles') %>?topic=<%= tp %>" aria-current="<%= topic === tp ? 'true' : 'false' %>"><%= t('articles.topics')[tp] %></a><% }) %>
    </nav>
    <% } %>
    <% const shown = articleList.filter(function (a) { return !topic || a.topic === topic; }); %>
    <% if (!shown.length) { %><p class="lead"><%= t('articles.empty') %></p><% } %>
    <div class="acards">
      <% shown.forEach(function (a) { %><%- include('../partials/article-card', { a: a }) %><% }) %>
    </div>
  </div>
</section>
<%- include('../partials/bottom') %>
