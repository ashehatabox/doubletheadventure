<%
  const b = book;
  const ld = {
    '@context': 'https://schema.org', '@type': 'Book', name: b.displayTitle,
    author: site.authors.map(function (n) { return { '@type': 'Person', name: n }; }),
    publisher: { '@type': 'Organization', name: 'A² Publishing' },
    inLanguage: b.languages,
    typicalAgeRange: '3-7', isPartOf: { '@type': 'BookSeries', name: 'Double the Adventure' },
    url: seo.canonical
  };
  // One workExample per edition on sale, with its ISBN when assigned (data/books.js editions).
  const liveEds = (b.editions || []).filter(function (e) { return e.status === 'live'; });
  if (liveEds.length) ld.workExample = liveEds.map(function (e) {
    const w = { '@type': 'Book', bookFormat: e.format === 'kindle' ? 'https://schema.org/EBook' : e.format === 'hardcover' ? 'https://schema.org/Hardcover' : 'https://schema.org/Paperback', inLanguage: e.lang, publisher: { '@type': 'Organization', name: 'A² Publishing' } };
    if (e.isbn) w.isbn = e.isbn;
    if (e.pages) w.numberOfPages = e.pages;
    return w;
  });
  const enPb = (b.editions || []).find(function (e) { return e.lang === 'en' && e.format === 'paperback' && e.isbn; });
  if (enPb) ld.isbn = enPb.isbn;
  if (pick(b.blurb)) ld.description = pick(b.blurb);
  if (b.cover) ld.image = seo.canonical.split('/').slice(0, 3).join('/') + b.cover;
%>
<%- include('../partials/top', { jsonLd: ld }) %>
<section class="section tight">
  <div class="wrap book-hero">
    <div><%- include('../partials/cover', { b: b, eager: true }) %></div>
    <div class="stack">
      <p class="eyebrow"><%= t('common.value') %>: <%= b.valueText %><%= b.cultureText ? ' · ' + b.cultureText : '' %></p>
      <div class="stack-sm">
        <h1 class="h1 book-title" <%- b.titleIsFallback ? 'lang="en"' : '' %>><%= b.displayTitle %></h1>
        <% if (pick(b.subtitle)) { %><p class="book-subtitle" <%- isFallback(b.subtitle) ? 'lang="en"' : '' %>><%= pick(b.subtitle) %></p><% } %>
      </div>
      <ul class="glance" aria-label="<%= t('book.aboutTitle') %>">
        <li><%= t('book.ageLabel') %> <%= site.ages %></li>
        <% if (b.languages.length > 1) { %><li><%= t('book.languagesCount').replace('{n}', b.languages.length) %></li><% } %>
        <% if (pick(b.hero)) { %><li <%- isFallback(b.hero) ? 'lang="en"' : '' %>><%= pick(b.hero) %></li><% } %>
      </ul>
      <% if (pick(b.blurb)) { %><p class="lead" <%- isFallback(b.blurb) ? 'lang="en"' : '' %>><%= pick(b.blurb) %></p><% } %>
      <% if (pick(b.themeLine)) { %><p class="quote" <%- isFallback(b.themeLine) ? 'lang="en"' : '' %>>“<%= pick(b.themeLine) %>”</p><% } %>

      <% if (b.status === 'live') { %>
      <div class="buy-box stack-sm">
        <div class="chips">
          <span class="chip" style="background:#fff"><%= t('common.amazonPrice') %></span>
        </div>
        <div class="row">
          <a class="btn btn-primary" href="<%= b.amazonMain %>" rel="noopener"><%= t('common.buyAmazon') %></a>
          <a class="btn btn-ghost" href="<%= url('/shop') %>"><%= t('common.giftSet') %></a>
          <% if (readHref) { %><a class="btn btn-ghost" href="<%= readHref %>"><%= readOpen ? t('reader.open') : t('reader.peek') %></a><% } %>
        </div>
        <details class="stores">
          <summary><%= t('common.otherStores') %></summary>
          <ul><% b.amazonStores.forEach(function (s) { %><li><a class="chip" href="<%= s.href %>" rel="noopener"><%= s.label %></a></li><% }) %></ul>
        </details>
      </div>
      <% } else { %>
      <div id="notify" class="notify-box stack-sm">
        <p class="notify-note"><%= b.status === 'soon' ? t('book.soonNote') : t('book.comingNote') %></p>
        <%- include('../partials/signup', { formId: 'notify-form', list: 'waitlist', book: b.slug, source: 'book-waitlist', button: t('common.notifyMe') }) %>
      </div>
      <% if (readHref) { %><a class="btn btn-ghost" style="align-self:flex-start" href="<%= readHref %>"><%= readOpen ? t('reader.open') : t('reader.peek') %></a><% } %>
      <% } %>
    </div>
  </div>
</section>

<section class="section tight" style="padding-top:0">
  <div class="wrap">
    <div class="about-book card">
      <h2 class="h3"><%= t('book.aboutTitle') %></h2>
      <dl>
        <div><dt><%= t('book.valueLabel') %></dt><dd><% if (b.status !== 'coming') { %><a href="<%= url('/values/' + b.value) %>"><%= b.valueText %></a><% } else { %><%= b.valueText %><% } %></dd></div>
        <% if (b.cultureText) { %><div><dt><%= t('book.cultureLabel') %></dt><dd><%= b.cultureText %><% if (pick(b.cultureIdea)) { %><span class="muted" <%- isFallback(b.cultureIdea) ? 'lang="en"' : '' %>><%= pick(b.cultureIdea) %></span><% } %></dd></div><% } %>
        <% if (pick(b.refrain)) { %><div><dt><%= t('book.refrainLabel') %></dt><dd <%- isFallback(b.refrain) ? 'lang="en"' : '' %>>“<%= pick(b.refrain) %>”</dd></div><% } %>
        <div><dt><%= t('book.languagesLabel') %></dt><dd><%= b.languages.map(langName).join(', ') %></dd></div>
      </dl>
    </div>
  </div>
</section>

<%
  const jump = [];
  if (readPreview) jump.push({ href: '#read', label: t('book.jumpRead') });
  if (readAloud.length) jump.push({ href: '#read-aloud', label: t('book.jumpWatch') });
  if (heroTeaser) jump.push({ href: '#heroes', label: t('book.jumpHeroes') });
  const playOn = b.status !== 'coming' && (colorPages.length || bookPlay.jigsaw || bookPlay.memory);
  if (playOn) jump.push({ href: '#play', label: t('book.jumpPlay') });
%>
<% if (jump.length > 1) { %>
<nav class="wrap jump" aria-label="<%= t('book.jumpLabel') %>">
  <span class="jump-label"><%= t('book.jumpLabel') %></span>
  <% jump.forEach(function (j) { %><a class="pill" href="<%= j.href %>"><%= j.label %></a><% }) %>
</nav>
<% } %>

<% if (readPreview) { %>
<section class="feature-band band-sky" id="read">
  <div class="wrap feature">
    <a class="feature-media spread-preview" href="<%= readHref %>" aria-label="<%= readOpen ? t('reader.open') : t('reader.peek') %>">
      <% readPreview.pages.forEach(function (src) { %><img src="<%= src %>" alt="<%= t('common.altSpread') %>" loading="lazy" width="1000" height="1000"><% }) %>
    </a>
    <div class="feature-text stack">
      <h2 class="h2 feature-h"><%= t('book.readTitle') %></h2>
      <p class="lead"><%= t('book.readText') %></p>
      <ul class="glance"><li><%= t('book.readPages').replace('{n}', readPreview.totalPages) %></li></ul>
      <a class="btn btn-primary" style="align-self:flex-start" href="<%= readHref %>"><%= readOpen ? t('reader.open') : t('reader.peek') %></a>
    </div>
  </div>
</section>
<% } %>

<% if (readAloud.length) { %>
<section class="feature-band band-rose" id="read-aloud">
  <div class="wrap feature feature-wide">
    <div class="feature-text stack">
      <h2 class="h2 feature-h"><%= t('readaloud.bookTitle') %></h2>
      <p class="lead"><%= t('book.watchText') %></p>
      <% if (readAloud.length > 1) { %><ul class="glance"><li><%= t('book.watchLangs').replace('{n}', readAloud.length) %></li></ul><% } %>
    </div>
    <div class="feature-media"><%- include('../partials/readaloud', { b: b, videos: readAloud }) %></div>
  </div>
</section>
<% } %>

<% if (bookPacks.length) { %>
<section class="section tight" id="packs">
  <div class="wrap stack" style="gap:24px">
    <div class="stack-sm" style="max-width:760px">
      <h2 class="h2 book-h2"><%= t('book.packsTitle') %></h2>
      <p class="lead"><%= t('book.packsLead') %></p>
    </div>
    <div class="pack-grid pack-grid-two">
      <% bookPacks.forEach(function (c) { %>
      <form class="pack-card" method="post" action="/shop/checkout">
        <input type="hidden" name="product" value="<%= c.id %>"><input type="hidden" name="lang" value="<%= lang %>">
        <% if (c.preview) { %><img class="pack-preview" src="<%= c.preview %>" alt="<%= t('shop.previewOf').replace('{title}', c.title) %>" loading="lazy" width="900" height="390"><% } %>
        <div class="pack-body">
          <h3 class="h3"><%= c.title %></h3>
          <p class="muted" style="margin:0"><%= c.text %></p>
          <p class="muted" style="margin:0;font-size:14px"><%= c.licence %></p>
          <span class="shop-price">$<%= c.price %> CAD</span>
          <button class="btn btn-primary" type="submit"><%= t('shop.buy') %></button>
        </div>
      </form>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (heroTeaser) { %>
<section class="feature-band band-mint" id="heroes">
  <div class="wrap stack" style="gap:32px">
    <div class="feature-head stack-sm">
      <h2 class="h2 feature-h"><%= t('book.heroesTitle') %></h2>
      <p class="lead"><%= heroTeaser.intro %></p>
    </div>
    <ul class="cast-grid">
      <% heroTeaser.cast.forEach(function (c) { %>
      <li class="cast-card">
        <% if (c.image) { %><img src="<%= c.image %>" alt="<%= c.name %>, <%= c.animal %>" loading="lazy" width="400" height="400"><% } else { %><span class="cast-ph" aria-hidden="true"></span><% } %>
        <span class="cast-name"><%= c.name %></span>
        <span class="cast-animal"><%= c.animal %></span>
        <% if (c.superpower) { %><span class="cast-power"><%= c.superpower %></span><% } %>
      </li>
      <% }) %>
    </ul>
    <% if (heroTeaser.fact || heroTeaser.placeImage) { %>
    <div class="place-card">
      <% if (heroTeaser.placeImage) { %><img src="<%= heroTeaser.placeImage %>" alt="<%= heroTeaser.place %>" loading="lazy" width="1200" height="800"><% } %>
      <div class="stack-sm place-text">
        <% if (heroTeaser.place) { %><p class="place-kicker"><%= t('book.heroesPlace') %>: <%= heroTeaser.place %></p><% } %>
        <% if (heroTeaser.fact) { %><h3 class="h3"><%= t('book.heroesFact') %> <%= heroTeaser.fact.title %></h3><p style="margin:0"><%= heroTeaser.fact.text %></p><% } %>
      </div>
    </div>
    <% } %>
    <a class="btn btn-primary" style="align-self:flex-start" href="<%= url('/heroes/' + b.slug) %>"><%= t('book.heroesCta').replace('{n}', heroTeaser.cast.length) %></a>
  </div>
</section>
<% } %>

<% if (playOn) { %>
<section class="feature-band band-sunpale" id="play">
  <div class="wrap stack" style="gap:28px">
    <div class="feature-head stack-sm">
      <h2 class="h2 feature-h"><%= t('book.playTitle') %></h2>
      <p class="lead"><%= t('book.playText') %></p>
    </div>
    <div class="bp-grid">
      <% if (colorPages.length) { %>
      <a class="bp-card" href="<%= url('/play/color/' + b.slug) %>">
        <span class="bp-art bp-art-color"><% colorPages.slice(0, 3).forEach(function (p) { %><img src="<%= p %>" alt="<%= t('common.altColoring') %>" loading="lazy" width="600" height="600"><% }) %></span>
        <span class="bp-title"><%= t('book.playColor') %></span>
        <span class="bp-text"><%= t('book.colorCardText') %></span>
      </a>
      <% } %>
      <% if (bookPlay.jigsaw) { %>
      <a class="bp-card" href="<%= url('/play/jigsaw/' + b.slug) %>">
        <span class="bp-art bp-art-jigsaw"><img src="<%= b.cover %>" alt="<%= t('common.coverOf') %> <%= b.displayTitle || bookTitle(b) %>" loading="lazy" width="900" height="1440"></span>
        <span class="bp-title"><%= t('book.playJigsaw') %></span>
        <span class="bp-text"><%= t('book.jigsawCardText') %></span>
      </a>
      <% } %>
      <% if (bookPlay.memory) { %>
      <a class="bp-card" href="<%= url('/play/memory') %>">
        <span class="bp-art bp-art-memory"><span class="mem-back"></span><img src="<%= b.cover %>" alt="<%= t('common.coverOf') %> <%= b.displayTitle || bookTitle(b) %>" loading="lazy" width="900" height="1440"><span class="mem-back"></span></span>
        <span class="bp-title"><%= t('book.playMemory') %></span>
        <span class="bp-text"><%= t('book.memoryCardText') %></span>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<% if (b.status !== 'coming') { %>
<section class="section">
  <div class="wrap stack">
    <h2 class="h2 book-h2"><%= t('book.grownTitle') %></h2>
    <div class="todo-grid">
      <a class="todo todo-white" href="<%= url('/parents') %>"><span class="todo-title"><%= t('book.homeTitle') %></span><span class="todo-text"><%= t('book.homeText') %></span></a>
      <a class="todo todo-white" href="<%= url('/educators') %>"><span class="todo-title"><%= t('book.classTitle') %></span><span class="todo-text"><%= t('book.classText') %></span></a>
      <% if (bookPlay.map) { %><a class="todo todo-white" href="<%= url('/values-map') %>"><span class="todo-title"><%= t('book.seeOnMap') %></span><span class="todo-text"><%= t('book.mapText') %></span></a><% } %>
      <a class="todo todo-white" href="<%= url('/shop') %>"><span class="todo-title"><%= t('book.giftTitle') %></span><span class="todo-text"><%= t('book.giftText') %></span></a>
    </div>
    <% if (b.status === 'live') { %>
    <div class="signup-box free-band">
      <div class="stack-sm">
        <h2 class="h3"><%= t('book.freeTitle') %></h2>
        <p style="margin:0"><%= t('book.freeText') %></p>
      </div>
      <%- include('../partials/signup', { formId: 'book-free-page', book: b.slug, source: 'book-free-page', label: t('home.freeLabel'), button: t('home.freeButton') }) %>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<% if (bookArticles.length) { %>
<section class="section tight" style="padding-top:0">
  <div class="wrap stack">
    <h2 class="h2 book-h2"><%= t('book.articlesTitle') %></h2>
    <div class="acards"><% bookArticles.forEach(function (a) { %><%- include('../partials/article-card', { a: a }) %><% }) %></div>
  </div>
</section>
<% } %>

<section class="section tight" style="padding-top:0" aria-labelledby="trade-title">
  <div class="wrap">
    <details class="card card-pad">
      <summary id="trade-title" style="font-weight:800;cursor:pointer;min-height:44px;display:flex;align-items:center"><%= t('bookTrade.title') %></summary>
      <div class="stack-sm" style="margin-top:12px">
        <% if (proof.culturalReviewers[b.slug]) { const cr = proof.culturalReviewers[b.slug]; %><p style="margin:0"><%= t('proof.reviewer').replace('{from}', pick(cr.from)) %><% if (cr.name) { %> (<%= cr.name %>)<% } %></p><% } %>
        <div class="table-wrap" tabindex="0" role="region" aria-labelledby="trade-title">
          <table class="dtable">
            <thead><tr><th scope="col"><%= t('bookTrade.colLang') %></th><th scope="col"><%= t('bookTrade.colFormat') %></th><th scope="col"><%= t('bookTrade.colIsbn') %></th><th scope="col"><%= t('bookTrade.colStatus') %></th></tr></thead>
            <tbody>
              <% (b.editions || []).forEach(function (e) { %>
              <tr><th scope="row"><%= langName(e.lang) %></th><td data-label="<%= t('bookTrade.colFormat') %>"><%= t('langs.formats.' + e.format) %></td><td data-label="<%= t('bookTrade.colIsbn') %>"><% if (e.isbn) { %><%= e.isbn %><% } else if (e.format === 'kindle') { %><%= e.asin ? 'ASIN ' + e.asin : '' %><% } else { %><%- include('../partials/pending', { k: 'isbn' }) %><% } %></td><td data-label="<%= t('bookTrade.colStatus') %>"><%= t('bookTrade.status.' + e.status) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% const pb = (b.editions || []).find(function (e) { return e.lang === 'en' && e.format === 'paperback'; }) || {}; %>
        <p style="margin:0"><strong><%= t('bookTrade.pagesTrim') %>:</strong> <%= [pb.pages ? pb.pages + ' pp' : '', pb.trim || ''].filter(Boolean).join(', ') %><% if (!pb.pages) { %> <%- include('../partials/pending', { k: 'pages' }) %><% } %></p>
        <p class="row" style="margin:0"><a href="<%= url('/books/' + b.slug + '/rights') %>" style="font-weight:800"><%= t('bookTrade.rightsSheet') %></a> <a href="<%= url('/educators/libraries') %>#titles" style="font-weight:800"><%= t('bookTrade.titleList') %></a></p>
      </div>
    </details>
  </div>
</section>

<% if (related.length) { %>
<section class="section tight" style="padding-top:0">
  <div class="wrap stack">
    <h2 class="h2 book-h2"><%= t('book.moreTitle') %></h2>
    <div class="grid-books"><% related.forEach(function (r) { %><%- include('../partials/book-card', { b: r }) %><% }) %></div>
  </div>
</section>
<% } %>
<%- include('../partials/bottom') %>
