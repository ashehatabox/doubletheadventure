 "activities": [
  {
   "title": {
    "en": "Stay close game"
   },
   "text": {
    "en": "Walk together holding a ribbon between you. Can you stay connected all the way across the room?"
   }
  },
  {
   "title": {
    "en": "Make a promise"
   },
   "text": {
    "en": "Make one small promise today, like 'I'll wait for you', and keep it. How did it feel?"
   }
  },
  {
   "title": {
    "en": "Whistle names"
   },
   "text": {
    "en": "Make up your own whistle name, like a dolphin. Can your family guess who's whistling?"
   }
  },
  {
   "title": {
    "en": "Colour change"
   },
   "text": {
    "en": "Draw a fish yellow, then colour it blue as it grows up, like a blue tang."
   }
  },
  {
   "title": {
    "en": "Find Bonaire"
   },
   "text": {
    "en": "Find the Caribbean Sea on a map, then the small island of Bonaire near Venezuela."
   }
  }
 ],
 "faq": [
  {
   "q": {
    "en": "What kind of fish are Finn and Coral?"
   },
   "a": {
    "en": "The book doesn't say. We think they look like blue tangs: yellow when young, blue when grown up."
   },
   "src": [
    "reef-tang"
   ]
  },
  {
   "q": {
    "en": "Do dolphins really have names?"
   },
   "a": {
    "en": "Yes, sort of. Each dolphin has its own signature whistle that works like a name."
   },
   "src": [
    "ngk-dolphin"
   ]
  },
  {
   "q": {
    "en": "Why are green sea turtles called green?"
   },
   "a": {
    "en": "Because their fat is greenish, from eating seagrass, not because of their shells."
   },
   "src": [
    "wwf-turtle"
   ]
  },
  {
   "q": {
    "en": "Do seahorse dads really have babies?"
   },
   "a": {
    "en": "Yes. The male carries the eggs in a pouch until they hatch."
   },
   "src": [
    "rsg-sea"
   ]
  }
