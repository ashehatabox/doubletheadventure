# Copy to .env (or add each line in cPanel > Setup Node.js App > Environment variables).

# Public address of the site, no trailing slash.
SITE_URL=https://doubleadventure.ca

# Supabase project "doubletheadventure". The publishable key is safe to use here:
# the tables only accept new rows from it and nobody can read them back through the API.
SUPABASE_URL=https://qhecthlbcqsuovpoykgd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_KfOl74FYPU09D-ChvaPFgA_CxHpAeaq

# Optional: Amazon Associates tags. Added to every "Buy on Amazon" link for that store.
AMAZON_TAG_CA=
AMAZON_TAG_COM=

# Optional: email a copy of every enquiry to this inbox.
STORE_EMAIL=
# Either Resend (works where the host blocks email ports)...
RESEND_API_KEY=
MAIL_FROM=A² Publishing <hello@doubleadventure.ca>
# ...or an SMTP account.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Welcome email: every message needs a working unsubscribe link (CASL). Use any long random text.
UNSUB_SECRET=
# Your mailing address, printed in the footer of each email (CASL requires one).
MAIL_ADDRESS=

# Shop (Stripe Checkout). Off until SHOP_OPEN=1, a Stripe key is set, and a product in data/shop.js has a price.
SHOP_OPEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe shipping rate ids (shr_...), comma separated.
STRIPE_SHIPPING_RATES=
# Set to 1 only after GST/HST registration is added in Stripe Tax.
STRIPE_AUTOMATIC_TAX=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = no analytics. Never loaded on /play or the reader.
GA4_ID=
