<%- include('../partials/top') %>
<section class="section tight no-print">
  <div class="wrap stack-sm" style="max-width:820px">
    <p class="muted"><a href="<%= url('/educators/classroom') %>"><%= t('classroom.cardsBack') %></a></p>
    <h1 class="h1" style="font-size:clamp(32px,4.2vw,48px)"><%= t('classroom.postersTitle') %></h1>
    <p class="lead"><%= t('classroom.postersLead') %></p>
    <div class="row" style="gap:12px;flex-wrap:wrap">
      <button class="btn btn-primary" type="button" data-print><%= t('classroom.postersPrint') %></button>
      <% if (single) { %><a class="btn" href="<%= url('/educators/classroom/posters') %>"><%= t('classroom.postersAll') %></a><% } %>
    </div>
  </div>
</section>
<section class="section tight posters-page">
  <div class="wrap posters">
    <% posters.forEach(function (b) { %>
    <article class="poster" style="--accent:<%= b.color || '#F7C873' %>">
      <img class="poster-cover" src="<%= b.cover %>" alt="" width="360" height="576" loading="lazy">
      <div class="poster-text">
        <h2 class="poster-title"><%= b.displayTitle %></h2>
        <% if (b.refrain) { %><p class="poster-label"><%= t('classroom.postersSing') %></p><p class="poster-refrain"><%= b.refrain %></p><% } %>
        <% if (b.theme) { %><p class="poster-label"><%= t('classroom.postersIdea') %></p><p class="poster-theme"><%= b.theme %></p><% } %>
        <% if (b.valueText) { %><p class="poster-value"><%= b.valueText %></p><% } %>
      </div>
    </article>
    <% }) %>
  </div>
</section>
<%- include('../partials/bottom') %>
