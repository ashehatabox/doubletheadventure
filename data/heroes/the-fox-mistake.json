 "faq": [
  {
   "q": {
    "en": "What's the difference between red and gray foxes?"
   },
   "a": {
    "en": "They're different species. Gray foxes are smaller and can climb trees; red foxes are the most common fox in the world."
   },
   "src": [
    "mf-rf",
    "cpw-gf"
   ]
  },
  {
   "q": {
    "en": "Can foxes really climb trees?"
   },
   "a": {
    "en": "Gray foxes can, using their turning wrists and hooked claws. Red foxes can't."
   },
   "src": [
    "cpw-gf",
    "pp-gf"
   ]
  },
  {
   "q": {
    "en": "How do foxes catch mice under snow?"
   },
   "a": {
    "en": "They listen hard, then do a high pounce, and may use Earth's magnetic field to aim."
   },
   "src": [
    "mf-rf"
   ]
  },
  {
   "q": {
    "en": "Do fox dads help with the babies?"
   },
   "a": {
    "en": "Yes. Red fox parents take turns hunting and bringing food to the kits."
   },
