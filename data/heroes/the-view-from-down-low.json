  "title": {
    "en": "Heroes of the Golden Plain"
  },
  "seoTitle": {
    "en": "Heroes of the Golden Plain: the real animals behind The View From Down Low"
  },
  "description": {
    "en": "A giraffe with a 50 cm tongue, meerkat lookouts, a tortoise that might live to 100 and warthogs that eat on their knees. Real facts for kids."
  },
  "intro": {
    "en": "Every animal in The View From Down Low is real, and they all live on the grassy plains of Southern Africa. Here is how they see the world, from very high and very low."
  },
  "place": {
    "name": {
      "en": "Tswalu Kalahari Reserve, South Africa"
    },
    "image": "place.jpg",
    "intro": {
      "en": "The book's golden plain has no name, so we picked a real place where giraffes, meerkats, leopard tortoises, guineafowl and warthogs all live: Tswalu Kalahari Reserve in South Africa."
    },
    "introSrc": [
      "tswalu-wildlife",
      "aws-tswalu"
    ],
    "facts": [
      {
        "kind": "wow",
        "title": {
          "en": "The great thirst"
        },
        "text": {
          "en": "The name Kalahari comes from Tswana words meaning \"the great thirst\" or \"the waterless place\". Tswalu's corner gets more rain, so it's called the green Kalahari."
        },
        "src": [
          "tswalu-info"
        ]
      },
      {
        "kind": "hidden",
        "title": {
          "en": "A new beginning"
        },
        "text": {
          "en": "Tswalu means \"new beginning\". Since the late 1990s, worn-out farmland has been turned back into wild land, about ten times bigger than it started."
        },
        "src": [
          "longrun",
          "shore"
        ]
      },
      {
        "kind": "wow",
        "title": {
          "en": "South Africa's biggest"
        },
        "text": {
          "en": "At more than 114,000 hectares, it's the largest private game reserve in South Africa."
        },
        "src": [
          "shore"
        ]
      },
      {
        "kind": "hidden",
        "title": {
          "en": "Ancient art"
        },
        "text": {
          "en": "The southern Kalahari is the ancestral home of the San people, and the reserve protects old rock engravings."
        },
        "src": [
          "tswalu-guide"
        ]
      },
      {
        "kind": "ha",
        "title": {
          "en": "Red dunes and old mountains"
        },
        "text": {
          "en": "Red sand dunes roll across the reserve, and the ancient Korannaberg mountains run through the middle."
        },
        "src": [
          "tswalu-guide"
        ]
      }
    ],
