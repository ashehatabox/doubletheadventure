  "faq": [
    {
      "q": {
        "en": "Are the animals in Tumble and the Honey Glow real?"
      },
      "a": {
        "en": "Yes. Brown bears, honeybees, European hedgehogs, brown hares and red squirrels all live together in the forests of Europe. We changed a few things for the story, and each hero tells you what."
      }
    },
    {
      "q": {
        "en": "Can I give my baby honey for a cough?"
      },
      "a": {
        "en": "Not before their first birthday. The CDC and the American Academy of Pediatrics say never to give honey to babies under 12 months, because of the risk of infant botulism. For older children with a cough that lasts, or any trouble breathing, talk to your doctor."
      },
      "src": [
        "ufl-botulism"
      ]
    },
    {
      "q": {
        "en": "Do bears really hibernate?"
      },
      "a": {
        "en": "Yes, in their own way. Bears sleep in a den for months without eating, drinking or going to the bathroom, but their body cools only a few degrees, so they can wake quickly."
      },
      "src": [
        "nps-katm-hib",
        "adw-bear"
      ]
    },
    {
      "q": {
        "en": "Do bears really love honey?"
      },
      "a": {
        "en": "They do raid beehives and eat honey, but they're mostly after the baby bees inside, which are full of protein."
      },
      "src": [
        "mentalfloss"
      ]
    }
