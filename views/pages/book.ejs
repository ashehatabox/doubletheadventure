<%
  const b = book;
  const ld = {
    '@context': 'https://schema.org', '@type': 'Book', name: b.displayTitle,
    author: site.authors.map(function (n) { return { '@type': 'Person', name: n }; }),
    publisher: { '@type': 'Organization', name: 'A² Publishing' },
    bookFormat: 'https://schema.org/Paperback', inLanguage: b.languages,
    typicalAgeRange: '3-7', isPartOf: { '@type': 'BookSeries', name: 'Double the Adventure' },
    url: seo.canonical
  };
  if (pick(b.blurb)) ld.description = pick(b.blurb);
  if (b.cover) ld.image = seo.canonical.split('/').slice(0, 3).join('/') + b.cover;
%>
<%- include('../partials/top', { jsonLd: ld }) %>
<section class="section tight">
  <div class="wrap book-hero">
    <div><%- include('../partials/cover', { b: b, eager: true }) %></div>
    <div class="stack">
      <p class="eyebrow"><%= t('common.value') %>: <%= b.valueText %><%= b.cultureText ? ' · ' + b.cultureText : '' %></p>
      <div class="stack-sm">
        <h1 class="h1 book-title" <%- b.titleIsFallback ? 'lang="en"' : '' %>><%= b.displayTitle %></h1>
        <% if (pick(b.subtitle)) { %><p class="book-subtitle" <%- isFallback(b.subtitle) ? 'lang="en"' : '' %>><%= pick(b.subtitle) %></p><% } %>
      </div>
      <ul class="glance" aria-label="<%= t('book.aboutTitle') %>">
        <li><%= t('book.ageLabel') %> <%= site.ages %></li>
        <% if (b.languages.length > 1) { %><li><%= t('book.languagesCount').replace('{n}', b.languages.length) %></li><% } %>
        <% if (pick(b.hero)) { %><li <%- isFallback(b.hero) ? 'lang="en"' : '' %>><%= pick(b.hero) %></li><% } %>
      </ul>
      <% if (pick(b.blurb)) { %><p class="lead" <%- isFallback(b.blurb) ? 'lang="en"' : '' %>><%= pick(b.blurb) %></p><% } %>
      <% if (pick(b.themeLine)) { %><p class="quote" <%- isFallback(b.themeLine) ? 'lang="en"' : '' %>>“<%= pick(b.themeLine) %>”</p><% } %>

      <% if (b.status === 'live') { %>
      <div class="buy-box stack-sm">
        <div class="chips">
          <span class="chip" style="background:#fff"><%= t('common.paperback') %> <%= site.prices.paperback %></span>
          <span class="chip" style="background:#fff"><%= t('common.kindle') %> <%= site.prices.kindle %></span>
        </div>
        <div class="row">
          <a class="btn btn-primary" href="<%= b.amazonMain %>" rel="noopener"><%= t('common.buyAmazon') %></a>
          <a class="btn btn-ghost" href="<%= url('/shop') %>"><%= t('common.giftSet') %></a>
          <% if (readHref) { %><a class="btn btn-ghost" href="<%= readHref %>"><%= readOpen ? t('reader.open') : t('reader.peek') %></a><% } %>
        </div>
        <details class="stores">
          <summary><%= t('common.otherStores') %></summary>
          <ul><% b.amazonStores.forEach(function (s) { %><li><a class="chip" href="<%= s.href %>" rel="noopener"><%= s.label %></a></li><% }) %></ul>
        </details>
      </div>
      <% } else { %>
      <div id="notify" class="notify-box stack-sm">
        <p class="notify-note"><%= b.status === 'soon' ? t('book.soonNote') : t('book.comingNote') %></p>
        <%- include('../partials/signup', { formId: 'notify-form', list: 'waitlist', book: b.slug, source: 'book-waitlist', button: t('common.notifyMe') }) %>
      </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section tight" style="padding-top:0">
  <div class="wrap">
    <div class="about-book card">
      <h2 class="h3"><%= t('book.aboutTitle') %></h2>
      <dl>
        <div><dt><%= t('book.valueLabel') %></dt><dd><% if (b.status !== 'coming') { %><a href="<%= url('/values/' + b.value) %>"><%= b.valueText %></a><% } else { %><%= b.valueText %><% } %></dd></div>
        <% if (b.cultureText) { %><div><dt><%= t('book.cultureLabel') %></dt><dd><%= b.cultureText %><% if (pick(b.cultureIdea)) { %><span class="muted" <%- isFallback(b.cultureIdea) ? 'lang="en"' : '' %>><%= pick(b.cultureIdea) %></span><% } %></dd></div><% } %>
        <% if (pick(b.refrain)) { %><div><dt><%= t('book.refrainLabel') %></dt><dd <%- isFallback(b.refrain) ? 'lang="en"' : '' %>>“<%= pick(b.refrain) %>”</dd></div><% } %>
        <div><dt><%= t('book.languagesLabel') %></dt><dd><%= b.languages.map(langName).join(', ') %></dd></div>
      </dl>
    </div>
  </div>
</section>

<%
  const todo = [];
  if (b.status !== 'coming') {
    if (bookPlay.heroes) todo.push({ href: url('/heroes/' + b.slug), title: t('book.meetAnimals'), text: t('book.animalsText'), tone: 'mint' });
    if (readAloud.length) todo.push({ href: '#read-aloud', title: t('readaloud.bookTitle'), text: t('book.readAloudText'), tone: 'rose' });
    if (bookPlay.color) todo.push({ href: url('/play/color/' + b.slug), title: t('book.playColor'), text: t('book.colorText'), tone: 'sun' });
    if (bookPlay.jigsaw) todo.push({ href: url('/play/jigsaw/' + b.slug), title: t('book.playJigsaw'), text: t('book.jigsawText'), tone: 'sky' });
    if (bookPlay.memory) todo.push({ href: url('/play/memory'), title: t('book.playMemory'), text: t('book.memoryText'), tone: 'rose' });
    if (bookPlay.map) todo.push({ href: url('/values-map'), title: t('book.seeOnMap'), text: t('book.mapText'), tone: 'mint' });
    todo.push({ href: url('/parents'), title: t('book.homeTitle'), text: t('book.homeText'), tone: 'white' });
    todo.push({ href: url('/educators'), title: t('book.classTitle'), text: t('book.classText'), tone: 'white' });
    todo.push({ href: url('/shop'), title: t('book.giftTitle'), text: t('book.giftText'), tone: 'white' });
  }
%>
<% if (todo.length) { %>
<section class="section tight" style="padding-top:0">
  <div class="wrap stack">
    <h2 class="h2 book-h2"><%= t('book.doTitle') %></h2>
    <div class="todo-grid">
      <% todo.forEach(function (x) { %><a class="todo todo-<%= x.tone %>" href="<%= x.href %>"><span class="todo-title"><%= x.title %></span><span class="todo-text"><%= x.text %></span></a><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (b.status === 'live') { %>
<section class="section tight" style="padding-top:0">
  <div class="wrap">
    <div class="signup-box stack-sm free-band">
      <div class="stack-sm">
        <h2 class="h3"><%= t('book.freeTitle') %></h2>
        <p style="margin:0"><%= t('book.freeText') %></p>
      </div>
      <%- include('../partials/signup', { formId: 'book-free-page', book: b.slug, source: 'book-free-page', label: t('home.freeLabel'), button: t('home.freeButton') }) %>
    </div>
  </div>
</section>
<% } %>

<% if (readAloud.length) { %>
<section class="section tight" id="read-aloud" style="padding-top:0">
  <div class="wrap stack-sm" style="max-width:900px">
    <h2 class="h2 book-h2"><%= t('readaloud.bookTitle') %></h2>
    <%- include('../partials/readaloud', { b: b, videos: readAloud }) %>
  </div>
</section>
<% } %>

<% if (bookArticles.length) { %>
<section class="section tight" style="padding-top:0">
  <div class="wrap stack">
    <h2 class="h2 book-h2"><%= t('book.articlesTitle') %></h2>
    <div class="acards"><% bookArticles.forEach(function (a) { %><%- include('../partials/article-card', { a: a }) %><% }) %></div>
  </div>
</section>
<% } %>

<% if (related.length) { %>
<section class="section tight" style="padding-top:0">
  <div class="wrap stack">
    <h2 class="h2 book-h2"><%= t('book.moreTitle') %></h2>
    <div class="grid-books"><% related.forEach(function (r) { %><%- include('../partials/book-card', { b: r }) %><% }) %></div>
  </div>
</section>
<% } %>
<%- include('../partials/bottom') %>
