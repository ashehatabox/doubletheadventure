      "life": [
        {
          "title": {
            "en": "Every worker is a girl"
          },
          "text": {
            "en": "In a hive, the queen lays the eggs, the boys (drones) don't work, and every single worker bee is a female. So Zuzu really is a she."
          },
          "src": [
            "adw-bee"
          ]
        },
        {
          "title": {
            "en": "How honey is made"
          },
          "text": {
            "en": "Zuzu sips nectar into a special honey stomach, flies home and hands it to younger bees. They add enzymes and fan it with their wings until the water dries away and it turns thick and sweet."
          },
          "src": [
            "adw-bee",
            "smithsonian-honey"
          ]
        },
        {
          "title": {
            "en": "Dance directions"
          },
          "text": {
            "en": "Found great flowers? A bee does a waggle dance on the comb that shows her sisters which way to fly and how far."
          },
          "src": [
            "adw-bee"
          ]
        }
      ],
      "facts": [
        {
          "kind": "wow",
          "title": {
            "en": "Two million flowers per jar"
          },
          "text": {
            "en": "To make one pound of honey, bees visit about 2 million flowers. One bee makes only about 1/12 of a teaspoon in her whole life."
          },
          "src": [
            "ucanr",
            "nasa-bee"
          ]
        },
        {
          "kind": "ha",
          "title": {
            "en": "A winter group hug"
          },
          "text": {
            "en": "Honeybees don't sleep through winter. They squeeze into a ball around the queen and shiver their flight muscles to keep the middle warm, even when it's freezing outside."
          },
          "src": [
            "adw-bee",
            "psu-winter"
          ]
        },
        {
          "kind": "hidden",
          "title": {
            "en": "Honey almost never goes bad"
          },
          "text": {
            "en": "Honey has so little water and so much acid that germs can't grow in it. Keep the lid on and it lasts for years and years."
          },
          "src": [
            "smithsonian-honey"
          ]
        },
        {
          "kind": "hidden",
          "title": {
            "en": "An old, old soother"
          },
          "text": {
            "en": "People have used honey for thousands of years: on ancient Sumerian clay tablets, it shows up in about a third of the written remedies."
          },
          "src": [
            "smithsonian-honey"
          ]
        }
      ],
      "storyVsReal": {
        "en": "Real honeybees stay home when it's cold or raining: they fly out to forage when it's warmer than about 16 °C and dry. So Zuzu flying through cold rain is her being an extra-brave friend."
      },
