        {
          "title": {
            "en": "Europe's only porcupine"
          },
          "text": {
            "en": "The crested porcupine is the only porcupine that lives in Europe, and in Europe you'll only find it in Italy."
          },
          "src": [
            "wiki-porc",
            "adw-porc"
          ]
        },
        {
          "title": {
            "en": "Big and puffy"
          },
          "text": {
            "en": "When it feels scared, a porcupine raises and fans out its quills to look much bigger than it really is."
          },
          "src": [
            "adw-porc"
          ]
        },
        {
          "title": {
            "en": "Backwards charge"
          },
          "text": {
            "en": "If a pest won't go away, it stamps its feet, rattles its quills and runs at them backwards, bottom first!"
          },
          "src": [
            "adw-porc2",
            "awf"
          ]
        },
        {
          "title": {
            "en": "Rattle tail"
          },
          "text": {
            "en": "Special hollow quills on its tail rattle when it shakes them, like a warning maraca."
          },
          "src": [
            "adw-porc",
            "awf"
          ]
        }
      ],
      "facts": [
        {
          "kind": "ha",
          "title": {
            "en": "No throwing!"
          },
          "text": {
            "en": "Porcupines can't shoot or throw their quills. They only come loose when something touches them."
