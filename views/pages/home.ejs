<%
  const live = allBooks.filter(function (b) { return b.status !== 'coming'; });
  const shelf = ['the-snug', 'the-pebbles-inside', 'eight-times-up', 'pip-the-brave-parrot'].map(function (s) { return allBooks.find(function (b) { return b.slug === s; }); });
  const heroBooks = ['the-snug', 'the-littlest-guardian', 'the-old-path-song'].map(function (s) { return allBooks.find(function (b) { return b.slug === s; }); });
  const coming = allBooks.filter(function (b) { return b.status === 'coming'; });
  const titleParts = t('home.title').split(/\{\{|\}\}/);
  const jsonLd = null;
  const icons = {
    parents: '<circle cx="8" cy="7" r="3"/><circle cx="17" cy="9" r="2"/><path d="M3 20c0-3 2.5-5 5-5s5 2 5 5"/><path d="M14 20c0-2 1.3-3.5 3-3.5s3 1.5 3 3.5"/>',
    educators: '<path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M7 9v5c0 1.7 2.2 3 5 3s5-1.3 5-3V9"/><path d="M21 7v6"/>',
    play: '<path d="M12 3c-5 0-9 3.6-9 8 0 3 2 4 4 4h1.5c1 0 1.5.8 1.5 1.6 0 1.5 1 2.4 2.4 2.4C17 19 21 15.4 21 11c0-4.4-4-8-9-8z"/><circle cx="7.5" cy="10" r="1"/><circle cx="11" cy="7" r="1"/><circle cx="15.5" cy="8" r="1"/>',
    partners: '<path d="M8 12l3 3 5-6"/><rect x="3" y="4" width="18" height="16" rx="3"/>'
  };
  const momentList = ['left-out', 'big-feelings', 'trying-again', 'sharing', 'brave', 'nature'];
%>
<%- include('../partials/top', { jsonLd: { '@context': 'https://schema.org', '@type': 'Organization', name: 'A² Publishing', url: seo.canonical, email: site.contactEmail, brand: 'Double the Adventure' } }) %>

<section class="section" aria-labelledby="hero-title">
  <div class="wrap grid-2">
    <div class="stack">
      <p class="eyebrow"><%= t('common.agesTag') %></p>
      <h1 id="hero-title" class="h1"><%= titleParts[0] %><span class="highlight"><%= titleParts[1] %></span><%= titleParts[2] %></h1>
      <p class="lead"><%= t('home.lead') %></p>
      <div class="row">
        <a class="btn btn-primary" href="<%= url('/books') %>"><%= t('common.exploreBooks') %></a>
        <a class="btn btn-ghost" href="#free-page"><%= t('common.getFreePage') %></a>
      </div>
      <div class="chips">
        <% [['belonging', '#A8DDA8'], ['resilience', '#CDB8F2'], ['guardianship', '#9FD3F0'], ['courage', '#FFB3B3'], ['elders', '#FFC93C']].forEach(function (v) { %>
        <span class="chip" style="background:<%= v[1] %>"><%= pick(catalog.values[v[0]]) %></span>
        <% }) %>
      </div>
    </div>
    <div class="hero-art">
      <% heroBooks.forEach(function (b, i) { %><%- include('../partials/cover', { b: b, eager: true }) %><% }) %>
    </div>
  </div>
</section>

<section class="section tight" aria-labelledby="doors-title" style="padding-top:0">
  <div class="wrap stack" style="gap:32px">
    <h2 id="doors-title" class="h2" style="text-align:center"><%= t('home.doorsTitle') %></h2>
    <div class="grid-cards">
      <% t('home.doors').forEach(function (d) { %>
      <a class="door <%= d.key %>" href="<%= url('/' + d.key) %>">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#0E7C7B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- icons[d.key] %></svg>
        <span class="door-title"><%= d.title %></span>
        <span class="door-text"><%= d.text %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section band-sun" aria-labelledby="featured-title">
  <div class="wrap grid-2">
    <div class="art" style="background:<%= featured.color %>;min-height:440px">
      <% if (featured.spread) { %><img src="<%= featured.spread %>" alt="" loading="lazy"><% } else if (featured.cover) { %><img src="<%= featured.cover %>" alt="" loading="lazy" style="object-position:top"><% } %>
    </div>
    <div class="stack">
      <p class="eyebrow"><%= t('common.newBook') %> · <%= featured.valueText %></p>
      <h2 id="featured-title" class="h2" <%- featured.titleIsFallback ? 'lang="en"' : '' %>><%= featured.displayTitle %></h2>
      <p class="lead" <%- isFallback(featured.blurb) ? 'lang="en"' : '' %>><%= pick(featured.blurb) %></p>
      <% if (featured.refrain) { %><p class="quote"><%= pick(featured.refrain) %></p><% } %>
      <div class="chips">
        <span class="chip" style="background:#fff"><%= t('common.paperback') %> <%= site.prices.paperback %></span>
        <span class="chip" style="background:#fff"><%= t('common.kindle') %> <%= site.prices.kindle %></span>
        <span class="chip" style="background:#fff"><%= featured.languages.map(function (l) { return l.toUpperCase(); }).join(' · ') %></span>
      </div>
      <div class="row">
        <% if (featured.status === 'live') { %>
        <a class="btn btn-primary" href="<%= featured.amazonMain %>" rel="noopener"><%= t('common.buyAmazon') %></a>
        <% } else { %>
        <a class="btn btn-primary" href="<%= featured.href %>#notify"><%= t('common.notifyAmazon') %></a>
        <% } %>
        <a class="btn btn-ghost" href="<%= featured.href %>"><%= t('common.readMore') %></a>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="map-title">
  <div class="wrap stack" style="gap:32px">
    <div class="stack-sm" style="max-width:720px">
      <p class="eyebrow"><%= t('home.mapEyebrow') %></p>
      <h2 id="map-title" class="h2"><%= t('home.mapTitle') %></h2>
      <p class="lead"><%= t('home.mapLead') %></p>
    </div>
    <%- include('../partials/values-map') %>
    <div class="row"><a class="btn btn-ghost" href="<%= url('/values-map') %>"><%= t('home.mapCta') %></a></div>
  </div>
</section>

<section class="section tight" aria-labelledby="shelf-title" style="padding-top:0">
  <div class="wrap stack" style="gap:28px">
    <div class="row" style="justify-content:space-between;align-items:flex-end">
      <h2 id="shelf-title" class="h2"><%= t('home.shelfTitle') %></h2>
      <a href="<%= url('/books') %>" style="font-weight:800"><%= t('common.seeAll') %></a>
    </div>
    <div class="chips" style="gap:10px">
      <% momentList.forEach(function (m) { %><a class="pill" href="<%= url('/books') %>?moment=<%= m %>"><%= momentLabel(m) %></a><% }) %>
    </div>
    <div class="grid-books">
      <% shelf.forEach(function (b) { %><%- include('../partials/book-card', { b: b }) %><% }) %>
    </div>
  </div>
</section>

<section class="section band-teal" aria-labelledby="play-title">
  <div class="wrap grid-2">
    <div class="stack">
      <p class="eyebrow"><%= t('home.playEyebrow') %></p>
      <h2 id="play-title" class="h2"><%= t('home.playTitle') %></h2>
      <p class="lead"><%= t('home.playLead') %></p>
      <div class="row"><a class="btn btn-sun" href="<%= url('/play') %>"><%= t('home.playCta') %></a></div>
    </div>
    <div class="play-tiles">
      <% t('home.playTiles').forEach(function (name, i) { const bg = ['#FFFFFF', '#9FD3F0', '#FFC59E'][i]; %>
      <div class="play-tile"><div class="art" style="background:<%= bg %>"><svg aria-hidden="true" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#4A3426" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- [icons.play, '<path d="M4 4h7v4a2 2 0 1 0 0 4v8H4z"/><path d="M11 4h9v7h-4a2 2 0 1 0-4 0"/>', '<rect x="3" y="4" width="8" height="11" rx="2"/><rect x="13" y="9" width="8" height="11" rx="2"/>'][i] %></svg></div><span><%= name %></span></div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" aria-label="<%= t('nav.parents') %> · <%= t('nav.educators') %>">
  <div class="wrap grid-cards" style="grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:24px">
    <div class="card card-pad stack" style="padding:36px">
      <p class="eyebrow"><%= t('home.parentsEyebrow') %></p>
      <h2 class="h2" style="font-size:32px"><%= t('home.parentsTitle') %></h2>
      <p class="muted" style="margin:0"><%= t('home.parentsLead') %></p>
      <ul class="clean"><% t('home.parentsQuestions').forEach(function (q) { %><li><%= q %></li><% }) %></ul>
      <div class="row"><a class="btn btn-primary" href="<%= url('/parents') %>"><%= t('home.parentsCta') %></a></div>
    </div>
    <div class="card card-pad stack" style="padding:36px">
      <p class="eyebrow"><%= t('home.educatorsEyebrow') %></p>
      <h2 class="h2" style="font-size:32px"><%= t('home.educatorsTitle') %></h2>
      <p class="muted" style="margin:0"><%= t('home.educatorsLead') %></p>
      <ul class="clean"><% t('home.educatorsPoints').forEach(function (q) { %><li><%= q %></li><% }) %></ul>
      <div class="row">
        <a class="btn btn-primary" href="<%= url('/educators') %>"><%= t('home.educatorsCta') %></a>
        <a class="btn btn-ghost" href="<%= url('/educators/early-years') %>"><%= t('home.earlyYearsCta') %></a>
      </div>
    </div>
  </div>
</section>

<section id="free-page" class="section tight" aria-labelledby="free-title" style="padding-top:0">
  <div class="wrap">
    <div class="signup-box grid-2" style="gap:40px">
      <div class="stack-sm">
        <h2 id="free-title" class="h2"><%= t('home.freeTitle') %></h2>
        <p style="margin:0;font-size:18px"><%= t('home.freeLead') %></p>
      </div>
      <%- include('../partials/signup', { formId: 'free-page-form', source: 'home-free-page', book: site.featured, label: t('home.freeLabel'), button: t('home.freeButton') }) %>
    </div>
  </div>
</section>

<section class="section tight" aria-labelledby="soon-title" style="padding-top:0">
  <div class="wrap stack" style="gap:28px">
    <div class="stack-sm">
      <p class="eyebrow"><%= t('home.soonEyebrow') %></p>
      <h2 id="soon-title" class="h2"><%= t('home.soonTitle') %></h2>
    </div>
    <div class="grid-cards">
      <% coming.forEach(function (b) { %>
      <a class="tile card" href="<%= b.href %>" style="background:#fff">
        <span class="tile-swatch" style="background:<%= b.color %>"><% if (b.cover) { %><img src="<%= b.cover %>" alt="" loading="lazy"><% } %></span>
        <span><span class="tile-title" <%- b.titleIsFallback ? 'lang="en"' : '' %>><%= b.displayTitle %></span><span class="tile-text" style="color:#0E7C7B;font-weight:800"><%= t('common.notifyMe') %></span></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section band-sky" aria-labelledby="about-title">
  <div class="wrap grid-2" style="gap:40px">
    <div class="hero-art" style="grid-template-columns:repeat(3,minmax(0,1fr))">
      <% live.slice(8, 11).forEach(function (b) { %><div style="grid-row:auto"><%- include('../partials/cover', { b: b }) %></div><% }) %>
    </div>
    <div class="stack">
      <p class="eyebrow"><%= t('home.aboutEyebrow') %></p>
      <h2 id="about-title" class="h2"><%= t('home.aboutTitle') %></h2>
      <p class="lead"><%= t('home.aboutLead') %></p>
      <a href="<%= url('/about') %>" style="font-weight:800"><%= t('home.aboutCta') %></a>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
