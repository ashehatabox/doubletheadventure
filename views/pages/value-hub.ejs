<%
  const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: t('valueHub.pageTitle').replace('{value}', label), description: seo.description, url: seo.canonical,
    hasPart: bookViews.map(function (b) { return { '@type': 'Book', name: b.displayTitle, url: seo.canonical.split('/').slice(0, 3).join('/') + b.href }; }) };
%>
<%- include('../partials/top', { jsonLd: ld }) %>
<section class="section tight band-sun">
  <div class="wrap stack-sm" style="max-width:820px;margin-left:auto;margin-right:auto">
    <p class="eyebrow"><a href="<%= url('/values') %>"><%= t('valueHub.indexTitle') %></a></p>
    <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('valueHub.pageTitle').replace('{value}', label) %></h1>
    <p class="lead"><%= t('valueHub.pageLead').replace('{value}', label.toLowerCase()) %></p>
  </div>
</section>
<section class="section tight">
  <div class="wrap stack" style="gap:28px">
    <h2 class="h2" style="font-size:30px"><%= t('valueHub.booksTitle') %></h2>
    <% bookViews.forEach(function (b) { %>
    <div class="card card-pad hub-book">
      <div class="hub-cover"><%- include('../partials/cover', { b: b }) %></div>
      <div class="stack-sm">
        <h3 class="h3"><a href="<%= b.href %>"><%= b.displayTitle %></a></h3>
        <% if (b.idea) { %><p style="margin:0"<%- lang !== 'en' ? ' lang="en"' : '' %>><%= b.idea %></p><% } %>
        <div class="row">
          <a class="btn btn-ghost" href="<%= b.href %>"><%= t('valueHub.aboutBook') %></a>
          <% if (b.hasGuide) { %><a class="btn btn-ghost" href="<%= url('/educators/guides/' + b.slug) %>"><%= t('valueHub.guide') %></a><% } %>
          <% if (b.hasColor) { %><a class="btn btn-ghost" href="<%= url('/play/color/' + b.slug) %>"><%= t('book.playColor') %></a><% } %>
        </div>
      </div>
    </div>
    <% }) %>
    <% if (arts.length) { %>
    <h2 class="h2" style="font-size:30px"><%= t('valueHub.articlesTitle') %></h2>
    <div class="acards"><% arts.forEach(function (a) { %><%- include('../partials/article-card', { a: a }) %><% }) %></div>
    <% } %>
    <h2 class="h2" style="font-size:30px"><%= t('valueHub.moreTitle') %></h2>
    <nav class="chips" style="gap:10px"><% others.forEach(function (o) { %><a class="pill" href="<%= o.href %>"><%= o.label %></a><% }) %></nav>
  </div>
</section>
<%- include('../partials/bottom') %>
