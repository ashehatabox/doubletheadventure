<%- include('../partials/top') %>
<section class="section tight">
  <div class="wrap stack" style="gap:32px">
    <div class="stack-sm" style="max-width:760px">
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('partners.title') %></h1>
      <p class="lead"><%= t('partners.lead') %></p>
    </div>
    <div class="grid-cards">
      <% t('partners.cards').forEach(function (c, i) { const cls = ['parents', 'educators', 'play', 'partners'][i]; %>
      <a class="door <%= cls %>" href="<%= url('/partners/' + c.key) %>"><span class="door-title"><%= c.title %></span><span class="door-text"><%= c.text %></span></a>
      <% }) %>
    </div>
  </div>
</section>
<%- include('../partials/bottom') %>
