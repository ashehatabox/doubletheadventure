<%- include('../partials/top') %>
<section class="section tight">
  <div class="wrap stack" style="gap:32px">
    <div class="stack-sm" style="max-width:760px">
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('shop.title') %></h1>
      <p class="lead"><%= t('shop.lead') %></p>
      <div class="row"><a class="btn btn-primary" href="<%= url('/books') %>"><%= t('common.exploreBooks') %></a></div>
    </div>
    <div class="grid-cards">
      <% t('shop.items').forEach(function (item, i) { const bg = ['#FFF1C2', '#DDF1FC', '#DDF5E2', '#FFE3DE', '#EFE6FC'][i % 5]; %>
      <div class="card card-pad stack-sm" style="background:<%= bg %>"><h2 class="h3"><%= item.title %></h2><p class="muted" style="margin:0"><%= item.text %></p></div>
      <% }) %>
    </div>
    <div class="signup-box stack-sm" style="max-width:720px">
      <h2 class="h3"><%= t('shop.signupTitle') %></h2>
      <%- include('../partials/signup', { formId: 'shop-signup', source: 'shop-opening' }) %>
    </div>
  </div>
</section>
<%- include('../partials/bottom') %>
