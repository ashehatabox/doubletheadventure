<%- include('../partials/top') %>
<section class="section tight">
  <div class="wrap stack" style="gap:32px">
    <div class="stack-sm" style="max-width:760px">
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('coming.title') %></h1>
      <p class="lead"><%= t('coming.lead') %></p>
    </div>
    <% [['soon', 'coming.soonHeading'], ['coming', 'coming.comingHeading']].forEach(function (group) { const list = allBooks.filter(function (b) { return b.status === group[0]; }); if (!list.length) return; %>
    <h2 class="h2" style="font-size:30px"><%= t(group[1]) %></h2>
    <div class="grid-books"><% list.forEach(function (b) { %><%- include('../partials/book-card', { b: b }) %><% }) %></div>
    <% }) %>
  </div>
</section>
<%- include('../partials/bottom') %>
