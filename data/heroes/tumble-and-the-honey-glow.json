          ]
        }
      ],
      "life": [
        {
          "title": {
            "en": "No house at all"
          },
          "text": {
            "en": "Unlike rabbits, hares never dig burrows. They spend the day lying flat and still in a form, a shallow dip in the grass, and trust their speed."
          },
          "src": [
            "wwt-hare"
          ]
        },
        {
          "title": {
            "en": "Babies born ready to run"
          },
          "text": {
            "en": "Baby hares, called leverets, are born above ground with fur on and eyes open. Rabbit babies are born bald and blind!"
          },
          "src": [
            "wwt-hare",
            "ypte-hare"
          ]
        },
        {
          "title": {
            "en": "Dinner once a day"
          },
          "text": {
            "en": "Mom hides each leveret in its own spot and visits just once a day, at dusk, for a few minutes of milk, so predators don't find them."
          },
          "src": [
            "ypte-hare",
            "discover-hare"
          ]
        }
      ],
      "facts": [
        {
          "kind": "wow",
          "title": {
            "en": "Zoom!"
          },
          "text": {
            "en": "Brown hares have been clocked at up to 60 km/h in a straight line, as fast as a car in town."
          },
          "src": [
            "adw-hare"
          ]
        },
        {
          "kind": "ha",
          "title": {
            "en": "The girls do the boxing"
          },
          "text": {
            "en": "People used to think boxing hares were two boys fighting. Usually it's a girl hare punching away a boy who won't leave her alone!"
          },
          "src": [
            "wwt-hare",
            "ywt-hare"
          ]
        },
        {
          "kind": "uhoh",
          "title": {
            "en": "Eyes in the sky"
          },
          "text": {
            "en": "Foxes, wild cats, big hawks and owls all hunt hares, which is why they freeze flat in their form and then run like the wind."
          },
          "src": [
            "adw-hare"
          ]
        }
      ],
      "storyVsReal": {
        "en": "Real brown hares like open fields more than thick forest, and they don't play in groups. And no ribbons."
      },
