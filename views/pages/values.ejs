<%- include('../partials/top') %>
<section class="section tight band-sun">
  <div class="wrap stack-sm" style="max-width:820px;margin-left:auto;margin-right:auto">
    <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px)"><%= t('valueHub.indexTitle') %></h1>
    <p class="lead"><%= t('valueHub.indexLead') %></p>
  </div>
</section>
<section class="section tight">
  <div class="wrap grid-books">
    <% items.forEach(function (it) { %>
    <a class="card guide-pick" href="<%= it.href %>">
      <%- include('../partials/cover', { b: it.book }) %>
      <span class="guide-pick-title"><%= it.label %></span>
    </a>
    <% }) %>
  </div>
</section>
<%- include('../partials/bottom') %>
