        }
      ],
      "life": [
        {
          "title": {
            "en": "On guard!"
          },
          "text": {
            "en": "While the mob digs for food, one meerkat stands on a high point as sentinel and calls out when danger comes."
          },
          "src": [
            "adw-meerkat"
          ]
        },
        {
          "title": {
            "en": "Babysitter club"
          },
          "text": {
            "en": "Grown-ups who aren't parents help raise the pups, bringing them food and staying at the den to guard them."
          },
          "src": [
            "adw-meerkat"
          ]
        },
        {
          "title": {
            "en": "Belly sunbathing"
          },
          "text": {
            "en": "On cold mornings meerkats lie on their backs to warm their tummies in the sun. When it's hot, they stretch out in the shade."
          },
          "src": [
            "adw-meerkat"
          ]
        }
      ],
      "facts": [
        {
          "kind": "uhoh",
          "title": {
            "en": "Eagles from the sky"
          },
          "text": {
            "en": "Jackals, martial eagles and tawny eagles are a meerkat's most dangerous enemies. That's why the lookout always watches the sky."
          },
          "src": [
            "adw-meerkat"
          ]
        },
        {
          "kind": "wow",
          "title": {
            "en": "Big litters"
          },
          "text": {
            "en": "A meerkat mom has 3 to 7 pups at a time, usually about 4."
          },
          "src": [
            "adw-meerkat"
          ]
        },
        {
          "kind": "ha",
          "title": {
            "en": "Dark sunglasses"
          },
          "text": {
            "en": "Meerkats have black rings around their big eyes."
          },
          "src": [
            "adw-meerkat"
          ]
        },
        {
          "kind": "hidden",
          "title": {
            "en": "Meet them at Tswalu"
          },
          "text": {
            "en": "Tswalu has two meerkat families so used to people that visitors can sit and watch them close up."
          },
          "src": [
            "aws-tswalu"
          ]
        }
      ],
      "storyVsReal": {
        "en": "Real meerkats really do stand up tall to see further, just like Themba. But they don't wear grass hats! And real meerkats almost never hang out with giraffes."
      },
      "storyVsRealSrc": [
