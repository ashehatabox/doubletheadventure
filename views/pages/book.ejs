<%
  const b = book;
  const ld = {
    '@context': 'https://schema.org', '@type': 'Book', name: b.displayTitle,
    author: site.authors.map(function (n) { return { '@type': 'Person', name: n }; }),
    publisher: { '@type': 'Organization', name: 'A² Publishing' },
    bookFormat: 'https://schema.org/Paperback', inLanguage: b.languages,
    typicalAgeRange: '3-7', isPartOf: { '@type': 'BookSeries', name: 'Double the Adventure' },
    url: seo.canonical
  };
  if (pick(b.blurb)) ld.description = pick(b.blurb);
  if (b.cover) ld.image = seo.canonical.split('/').slice(0, 3).join('/') + b.cover;
%>
<%- include('../partials/top', { jsonLd: ld }) %>
<section class="section tight">
  <div class="wrap book-hero">
    <div><%- include('../partials/cover', { b: b, eager: true }) %></div>
    <div class="stack">
      <p class="eyebrow"><%= t('common.value') %>: <%= b.valueText %><%= b.cultureText ? ' · ' + b.cultureText : '' %></p>
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,56px)" <%- b.titleIsFallback ? 'lang="en"' : '' %>><%= b.displayTitle %></h1>
      <% if (pick(b.subtitle)) { %><p class="lead" style="font-weight:700" <%- isFallback(b.subtitle) ? 'lang="en"' : '' %>><%= pick(b.subtitle) %></p><% } %>
      <% if (pick(b.blurb)) { %><p class="lead" <%- isFallback(b.blurb) ? 'lang="en"' : '' %>><%= pick(b.blurb) %></p><% } %>
      <% if (pick(b.themeLine)) { %><p class="quote" <%- isFallback(b.themeLine) ? 'lang="en"' : '' %>>“<%= pick(b.themeLine) %>”</p><% } %>

      <% if (b.status === 'live') { %>
      <div class="chips">
        <span class="chip" style="background:#fff"><%= t('common.paperback') %> <%= site.prices.paperback %></span>
        <span class="chip" style="background:#fff"><%= t('common.kindle') %> <%= site.prices.kindle %></span>
      </div>
      <div class="row">
        <a class="btn btn-primary" href="<%= b.amazonMain %>" rel="noopener"><%= t('common.buyAmazon') %></a>
        <a class="btn btn-ghost" href="<%= url('/shop') %>"><%= t('common.giftSet') %></a>
      </div>
      <details class="stores">
        <summary><%= t('common.otherStores') %></summary>
        <ul><% b.amazonStores.forEach(function (s) { %><li><a class="chip" href="<%= s.href %>" rel="noopener"><%= s.label %></a></li><% }) %></ul>
      </details>
      <% } else { %>
      <div id="notify" class="card card-pad stack-sm" style="background:#FFF1C2;border-color:#FFD966">
        <p style="margin:0;font-weight:700"><%= b.status === 'soon' ? t('book.soonNote') : t('book.comingNote') %></p>
        <%- include('../partials/signup', { formId: 'notify-form', list: 'waitlist', book: b.slug, source: 'book-waitlist', button: t('common.notifyMe') }) %>
      </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section tight" style="padding-top:0">
  <div class="wrap facts">
    <div class="fact"><div class="fact-label"><%= t('book.valueLabel') %></div><div class="fact-value"><%= b.valueText %></div></div>
    <% if (b.cultureText) { %><div class="fact"><div class="fact-label"><%= t('book.cultureLabel') %></div><div class="fact-value"><%= b.cultureText %></div><% if (pick(b.cultureIdea)) { %><div class="muted" style="margin-top:4px" <%- isFallback(b.cultureIdea) ? 'lang="en"' : '' %>><%= pick(b.cultureIdea) %></div><% } %></div><% } %>
    <% if (pick(b.hero)) { %><div class="fact"><div class="fact-label"><%= t('book.heroLabel') %></div><div class="fact-value" <%- isFallback(b.hero) ? 'lang="en"' : '' %>><%= pick(b.hero) %></div></div><% } %>
    <% if (pick(b.refrain)) { %><div class="fact"><div class="fact-label"><%= t('book.refrainLabel') %></div><div class="fact-value" <%- isFallback(b.refrain) ? 'lang="en"' : '' %>><%= pick(b.refrain) %></div></div><% } %>
    <div class="fact"><div class="fact-label"><%= t('book.languagesLabel') %></div><div class="fact-value"><%= b.languages.map(langName).join(', ') %></div></div>
    <div class="fact"><div class="fact-label"><%= t('book.ageLabel') %></div><div class="fact-value"><%= site.ages %></div></div>
  </div>
</section>

<% if (b.status !== 'coming') { %>
<section class="section tight" style="padding-top:0">
  <div class="wrap grid-cards" style="grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:24px">
    <div class="signup-box stack-sm" style="padding:32px">
      <h2 class="h3"><%= t('book.freeTitle') %></h2>
      <p style="margin:0"><%= t('book.freeText') %></p>
      <%- include('../partials/signup', { formId: 'book-free-page', book: b.slug, source: 'book-free-page', label: t('home.freeLabel'), button: t('home.freeButton') }) %>
    </div>
    <div class="card card-pad stack-sm">
      <h2 class="h3"><%= t('book.directTitle') %></h2>
      <p class="muted" style="margin:0"><%= t('book.directText') %></p>
      <a href="<%= url('/parents') %>" style="font-weight:800"><%= t('book.parentsLink') %></a>
      <a href="<%= url('/educators') %>" style="font-weight:800"><%= t('book.teachersLink') %></a>
    </div>
  </div>
</section>
<% } %>

<% if (bookPlay.color || bookPlay.jigsaw || bookArticles.length || bookPlay.map) { %>
<section class="section tight" style="padding-top:0">
  <div class="wrap stack">
    <% if (bookPlay.color || bookPlay.jigsaw) { %>
    <h2 class="h2" style="font-size:32px"><%= t('book.playTitle') %></h2>
    <div class="row">
      <% if (bookPlay.color) { %><a class="btn btn-ghost" href="<%= url('/play/color/' + b.slug) %>"><%= t('book.playColor') %></a><% } %>
      <% if (bookPlay.jigsaw) { %><a class="btn btn-ghost" href="<%= url('/play/jigsaw/' + b.slug) %>"><%= t('book.playJigsaw') %></a><% } %>
      <% if (bookPlay.memory) { %><a class="btn btn-ghost" href="<%= url('/play/memory') %>"><%= t('book.playMemory') %></a><% } %>
      <% if (bookPlay.map) { %><a class="btn btn-ghost" href="<%= url('/values-map') %>"><%= t('book.seeOnMap') %></a><% } %>
    </div>
    <% } %>
    <% if (bookArticles.length) { %>
    <h2 class="h2" style="font-size:32px"><%= t('book.articlesTitle') %></h2>
    <div class="acards"><% bookArticles.forEach(function (a) { %><%- include('../partials/article-card', { a: a }) %><% }) %></div>
    <% } %>
  </div>
</section>
<% } %>

<% if (related.length) { %>
<section class="section tight" style="padding-top:0">
  <div class="wrap stack">
    <h2 class="h2" style="font-size:32px"><%= t('book.moreTitle') %></h2>
    <div class="grid-books"><% related.forEach(function (r) { %><%- include('../partials/book-card', { b: r }) %><% }) %></div>
  </div>
</section>
<% } %>
<%- include('../partials/bottom') %>
