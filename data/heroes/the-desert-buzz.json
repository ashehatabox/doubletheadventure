 "faq": [
  {
   "q": {
    "en": "What kind of beetle is Etoo?"
   },
   "a": {
    "en": "The book doesn't say. We picked the pinacate beetle, a small black beetle from North American deserts."
   },
   "src": [
    "dm-pin"
   ]
  },
  {
   "q": {
    "en": "Why do bees dance?"
   },
   "a": {
    "en": "To tell the other bees which way to fly and how far to go to find flowers."
   },
   "src": [
    "tx-bee"
   ]
  },
  {
   "q": {
    "en": "Are desert hairy scorpions dangerous?"
   },
   "a": {
    "en": "Their sting hurts, about like a bee sting, but it isn't strong enough to kill a person. Never touch one."
   },
   "src": [
    "tmp-sco"
   ]
  },
  {
   "q": {
    "en": "Why do saguaros have arms?"
   },
   "a": {
    "en": "Old saguaros grow arms, usually after 60 to 75 years. More arms mean more flowers."
   },
   "src": [
    "nps-sag"
   ]
  }
