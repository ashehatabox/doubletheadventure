 "faq": [
  {
   "q": {
    "en": "Are the animals in The Spring That Wanted to Stay real?"
   },
   "a": {
    "en": "Yes. Otters, grey herons, bumblebees and common frogs all live in Europe. Nura and Willo aren't animals: Nura is a spring and Willo is a willow tree."
   }
  },
  {
   "q": {
    "en": "Where do mountain springs come from?"
   },
   "a": {
    "en": "In the Alps, melting snow and glaciers feed springs, streams and waterfalls."
   },
   "src": [
    "np-waters"
   ]
  },
  {
   "q": {
    "en": "Why do otters need clean rivers?"
   },
   "a": {
    "en": "Most of what an otter eats is fish, so it needs rivers full of water and fish."
   },
   "src": [
    "taf-otter"
   ]
  },
  {
   "q": {
    "en": "How big is the biggest waterfall in Europe?"
   },
   "a": {
    "en": "The Krimml Waterfalls in Austria drop about 380 m."
   },
   "src": [
    "islands"
   ]
  }
